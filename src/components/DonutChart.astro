---
/**
 * Dependency-free donut chart built with a CSS conic-gradient (no SVG/JS
 * charting library, fully theme-aware since segment colors are CSS custom
 * properties). Shows real counts only - e.g. "3 completed projects, 1 in
 * progress" - never an invented percentage or score. The legend doubles as
 * the accessible text equivalent.
 */
interface Segment {
  label: string;
  value: number;
  color: string;
}
interface Props {
  segments: Segment[];
  centerLabel: string;
  summaryLabel: string;
}
const { segments, centerLabel, summaryLabel } = Astro.props;
const total = segments.reduce((sum, s) => sum + s.value, 0);

let cursor = 0;
const stops = segments
  .map((s) => {
    const start = (cursor / total) * 360;
    cursor += s.value;
    const end = (cursor / total) * 360;
    return `${s.color} ${start}deg ${end}deg`;
  })
  .join(', ');
---

<div class="donut-chart" role="img" aria-label={segments.map((s) => `${s.label}: ${s.value}`).join(', ')}>
  <div class="donut-visual" aria-hidden="true">
    <div class="donut-ring" style={`background: conic-gradient(${stops});`}>
      <div class="donut-hole">
        <span class="donut-total">{total}</span>
      </div>
    </div>
    <span class="donut-center-label">{centerLabel}</span>
  </div>

  <ul class="legend">
    {segments.map((s) => (
      <li>
        <span class="swatch" style={`background:${s.color}`}></span>
        {s.label} <strong>{s.value}</strong>
      </li>
    ))}
  </ul>

  <details class="text-summary">
    <summary>{summaryLabel}</summary>
    <ul>
      {segments.map((s) => <li>{s.label}: {s.value}</li>)}
    </ul>
  </details>
</div>

<style>
  .donut-chart {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }
  .donut-visual {
    position: relative;
    width: 120px;
    flex-shrink: 0;
    text-align: center;
  }
  .donut-ring {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .donut-hole {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .donut-total {
    font-size: var(--fs-700);
    font-weight: var(--fw-black);
    color: var(--color-text);
  }
  .donut-center-label {
    display: block;
    margin-top: var(--space-1);
    font-size: var(--fs-100);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: var(--fs-200);
    color: var(--color-text);
  }
  .legend strong {
    color: var(--color-text-muted);
    font-weight: var(--fw-heading);
  }
  .swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 0.5em;
  }
  .text-summary {
    flex-basis: 100%;
  }
  .text-summary summary {
    cursor: pointer;
    font-size: var(--fs-100);
    color: var(--color-text-muted);
    width: fit-content;
  }
  .text-summary ul {
    margin: var(--space-1) 0 0;
    padding-left: 1.2em;
    font-size: var(--fs-200);
    color: var(--color-text-muted);
  }
</style>
