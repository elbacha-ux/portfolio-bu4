---
/**
 * Interactive magazine flipbook, built from the pages rendered by
 * scripts/pdf-to-pages.mjs (see src/data/magazine-pages.json). Progressive
 * enhancement: the stage shows a plain cover image and a <noscript> PDF
 * link by default; only `html.js .magazine-flipbook` (global.css gate,
 * same pattern as ProjectBook.astro) reveals the prev/next/fullscreen
 * controls, and src/lib/flipbook.ts arms the actual page-turning once the
 * section scrolls into view.
 */
import { ui } from '../i18n/ui';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Page file names from magazine-pages.json, e.g. "page-01.webp". */
  pages: string[];
  width: number;
  height: number;
  /** Base-relative path to the PDF (no leading slash). */
  pdfPath: string;
  coverAlt: string;
}
const { lang, pages, width, height, pdfPath, coverAlt } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL;

const pageUrls = pages.map((p) => `${base}magazine/pages/${p}`);
const pdfHref = `${base}${pdfPath}`;
---

<div
  class="magazine-flipbook"
  data-flipbook
  data-pages={JSON.stringify(pageUrls)}
  data-width={width}
  data-height={height}
  data-page-status={t.magazine.flipbookPageStatus}
  data-fullscreen-enter={t.magazine.flipbookFullscreenEnter}
  data-fullscreen-exit={t.magazine.flipbookFullscreenExit}
  style={`--flipbook-ratio: ${width} / ${height};`}
>
  <div class="flipbook-viewport" data-flipbook-viewport>
    <div class="flipbook-sizer">
      <div class="flipbook-stage" data-flipbook-stage tabindex="0" aria-label={t.magazine.flipbookLabel}>
        <img src={pageUrls[0]} alt={coverAlt} width={width} height={height} class="flipbook-fallback-cover" />
      </div>
    </div>
  </div>

  <div class="flipbook-controls">
    <button type="button" class="flipbook-btn" data-flipbook-prev aria-label={t.magazine.flipbookPrev} data-sound="click">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    </button>
    <p class="flipbook-indicator" data-flipbook-indicator aria-live="polite">1 / {pages.length}</p>
    <button type="button" class="flipbook-btn" data-flipbook-next aria-label={t.magazine.flipbookNext} data-sound="click">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
    </button>
    <button type="button" class="flipbook-btn flipbook-fullscreen" data-flipbook-fullscreen aria-label={t.magazine.flipbookFullscreenEnter} data-sound="click">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" /></svg>
    </button>
  </div>

  <noscript>
    <p class="flipbook-noscript"><a href={pdfHref}>{t.magazine.pdfDownload}</a></p>
  </noscript>
</div>

<style>
  .magazine-flipbook {
    position: relative;
  }

  /* Transparent (not --color-bg-muted) - StPageFlip's canvas paints its
     own opaque white behind the cover/back-cover (shown alone, on only
     half the canvas - see the centering fix below), so a tinted
     background would still show a visible box around it. */
  .magazine-flipbook,
  .flipbook-viewport,
  .flipbook-stage {
    background: transparent;
  }
  /* The viewport clips to the stage's natural width normally. On the
     cover/back-cover (src/lib/flipbook.ts toggles .is-cover-shifted) it
     narrows to exactly one page's width while .flipbook-sizer - sized to
     200% of *its* parent, so the stage inside it (which StPageFlip keeps
     forcing to its own inline "width: 100%", overriding any width rule we
     put directly on .flipbook-stage) ends up back at its original
     absolute size, keeping StPageFlip's internal scale unaffected - is
     centered inside the viewport via auto margins. Combined with the
     wrapper's +/-25% translateX (half a page width), the occupied half of
     the canvas lands exactly inside this narrowed window and the blank
     half is clipped away entirely, rather than just nudged (a translateX
     shift alone can center the occupied half but still leaves a sliver of
     the blank half showing). */
  .flipbook-viewport {
    width: 100%;
    margin-inline: auto;
    overflow: hidden;
  }
  .flipbook-sizer {
    width: 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .flipbook-viewport {
      transition: width 400ms ease;
    }
  }
  .magazine-flipbook.is-cover-shifted .flipbook-viewport {
    width: 50%;
  }
  .magazine-flipbook.is-cover-shifted .flipbook-sizer {
    width: 200%;
    /* `margin-inline: auto` does NOT center an element wider than its
       container - auto margins collapse to 0 and all the overflow goes
       to one side when over-constrained. An explicit -50% margin (of the
       *viewport's* width, which is this element's containing block) is
       the actual centering math: (200% - 100%) / 2 = 50%. */
    margin-left: -50%;
  }
  .flipbook-stage {
    width: 100%;
    aspect-ratio: var(--flipbook-ratio);
    overflow: hidden;
  }
  .flipbook-fallback-cover {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* Once StPageFlip mounts its own canvas - appended alongside the
     fallback image, not in place of it - the stage switches to that
     canvas's own sizing (a padding-bottom trick on .stf__wrapper) instead
     of the placeholder aspect-ratio box, and the fallback image is hidden.
     overflow stays hidden (not auto/visible): the cover/back-cover
     centering fix shifts the canvas partly out of the stage on purpose,
     and that excess must stay clipped rather than spilling into the page. */
  .magazine-flipbook.is-active .flipbook-fallback-cover {
    display: none;
  }
  .magazine-flipbook.is-active .flipbook-stage {
    aspect-ratio: auto;
  }

  .flipbook-controls {
    display: none;
  }

  .flipbook-noscript {
    margin-top: var(--space-3);
  }

  @media (min-width: 641px) {
    :global(html.js) .flipbook-stage {
      /* StPageFlip renders its own canvas sized via JS (size: "stretch") -
         the aspect-ratio box above just reserves layout space and shows
         the fallback cover until then. */
      cursor: grab;
    }
  }

  :global(html.js) .flipbook-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .flipbook-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: var(--border-weight) solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard);
  }
  .flipbook-btn:hover,
  .flipbook-btn:focus-visible {
    border-color: var(--color-accent-strong);
    color: var(--color-accent-strong);
  }
  .flipbook-btn svg {
    width: 20px;
    height: 20px;
  }
  .flipbook-fullscreen.is-fullscreen svg {
    transform: rotate(180deg);
  }
  .flipbook-indicator {
    min-width: 6ch;
    text-align: center;
    font-size: var(--fs-200);
    font-weight: var(--fw-heading);
    color: var(--color-text-muted);
  }

  :global(.magazine-flipbook:fullscreen) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--color-navy);
    padding: var(--space-4);
  }
  :global(.magazine-flipbook:fullscreen) .flipbook-viewport {
    flex: 1 1 auto;
    height: 0;
    min-height: 0;
  }
  :global(.magazine-flipbook:fullscreen) .flipbook-sizer {
    height: 100%;
  }
  :global(.magazine-flipbook:fullscreen) .flipbook-stage {
    aspect-ratio: auto;
    height: 100%;
  }
</style>

<script>
  import { initMagazineFlipbook } from '../lib/flipbook';
  initMagazineFlipbook();
</script>
