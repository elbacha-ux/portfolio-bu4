---
import type { Member } from '../data/types';
import PhotoOverlay from './PhotoOverlay.astro';
import Button from './Button.astro';
import Placeholder from './Placeholder.astro';
import { ui } from '../i18n/ui';
import { pick, pickAll, localePath } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  bum: Member;
  lang: Lang;
  /** Compact: homepage teaser with a link to /bum. Full: the /bum page itself. */
  variant?: 'compact' | 'full';
}
const { bum, lang, variant = 'compact' } = Astro.props;
const t = ui[lang];
const intro = pick(bum.intro, lang);
const responsibilities = bum.leadership ? pickAll(bum.leadership.responsibilities, lang) : [];
const philosophy = bum.leadership ? pick(bum.leadership.philosophy, lang) : null;
---

<section class={`bum-spotlight ${variant}`}>
  <div class="photo-col">
    <PhotoOverlay src={bum.photo} name={bum.name} lang={lang} ratio="1 / 1" />
  </div>
  <div class="content-col">
    <p class="eyebrow">{t.bum.title}</p>
    <h2>{bum.name}</h2>
    {intro ? <p class="intro">{intro}</p> : <p class="intro"><Placeholder label={t.bum.placeholderIntro} lang={lang} /></p>}

    {variant === 'full' && (
      <>
        <h3>{t.bum.responsibilitiesTitle}</h3>
        {responsibilities.length ? (
          <ul>
            {responsibilities.map((r) => <li>{r}</li>)}
          </ul>
        ) : (
          <p><Placeholder label={t.bum.placeholderResponsibilities} lang={lang} /></p>
        )}

        {philosophy && (
          <>
            <h3>{t.bum.philosophyTitle}</h3>
            <p class="quote">&ldquo;{philosophy}&rdquo;</p>
          </>
        )}
      </>
    )}

    {variant === 'compact' && (
      <Button href={localePath(lang, 'bum/')} variant="inverse">{t.common.meetTheBum}</Button>
    )}
  </div>
</section>

<style>
  .bum-spotlight {
    display: grid;
    gap: var(--space-4);
    background: var(--color-navy);
    color: var(--color-text-inverse);
    padding: var(--space-4);
    box-shadow: var(--shadow-md);
  }
  .photo-col {
    max-width: 320px;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: var(--fw-heading);
    color: var(--color-light-blue);
    margin-bottom: var(--space-1);
  }
  .content-col h2 {
    color: var(--color-white);
    font-size: var(--fs-700);
  }
  .content-col h3 {
    color: var(--color-white);
    font-size: var(--fs-500);
    margin-top: var(--space-3);
  }
  .intro,
  .content-col p,
  .content-col li {
    color: #e7edf2;
  }
  .quote {
    font-style: italic;
    border-left: 3px solid var(--color-blue);
    padding-left: var(--space-2);
  }

  @media (min-width: 768px) {
    .bum-spotlight {
      grid-template-columns: 280px 1fr;
      align-items: start;
      padding: var(--space-5);
    }
  }
</style>
