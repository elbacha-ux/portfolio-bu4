---
/**
 * Member portrait treatment: a diagonal blue wedge accent (charter visual
 * language, consistent with the tone-on-tone rule in section 2.3) and a
 * neutral initials fallback when no approved photo exists yet - never a
 * stock photo or a random substitute.
 */
import type { Lang } from '../i18n';

interface Props {
  src: string | null;
  name: string;
  ratio?: string;
  lang?: Lang;
}
const { src, name, ratio = '4 / 5', lang = 'en' } = Astro.props;
// `src` is base-relative (no leading slash, e.g. "images/members/x.jpg"),
// same convention as every other asset path in the data layer - prefixed
// here so every caller doesn't have to repeat it.
const resolvedSrc = src ? `${import.meta.env.BASE_URL}${src}` : null;
const alt = lang === 'fr' ? `Portrait de ${name}` : `Portrait of ${name}`;
const initials = name
  .split(' ')
  .map((p) => p[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<div class="photo-frame" style={`aspect-ratio: ${ratio};`} data-sound-hover={src ? 'true' : undefined}>
  {resolvedSrc ? (
    <img src={resolvedSrc} alt={alt} loading="lazy" width="480" height="600" />
  ) : (
    <div class="fallback" role="img" aria-label={alt}>
      <span>{initials}</span>
    </div>
  )}
  <span class="wedge" aria-hidden="true"></span>
</div>

<style>
  .photo-frame {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-muted);
  }
  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  .photo-frame:hover img {
    transform: scale(1.06);
  }
  @media (prefers-reduced-motion: reduce) {
    .photo-frame img {
      transition: none;
    }
  }
  .fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(155deg, var(--color-navy) 0%, var(--color-navy) 55%, var(--color-cool-gray) 55%, var(--color-cool-gray) 100%);
  }
  .fallback span {
    font-weight: var(--fw-black);
    font-size: var(--fs-800);
    color: var(--color-white);
  }
  .wedge {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 55%;
    height: 35%;
    background: var(--color-blue);
    opacity: 0.85;
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
  }
</style>
