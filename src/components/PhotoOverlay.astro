---
/**
 * Member portrait treatment: a diagonal blue wedge accent (charter visual
 * language, consistent with the tone-on-tone rule in section 2.3) and a
 * neutral initials fallback when no approved photo exists yet - never a
 * stock photo or a random substitute.
 */
interface Props {
  src: string | null;
  alt: string | null;
  name: string;
  ratio?: string;
}
const { src, alt, name, ratio = '4 / 5' } = Astro.props;
const initials = name
  .split(' ')
  .map((p) => p[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<div class="photo-frame" style={`aspect-ratio: ${ratio};`}>
  {src ? (
    <img src={src} alt={alt ?? name} loading="lazy" width="480" height="600" />
  ) : (
    <div class="fallback" role="img" aria-label={`Portrait placeholder for ${name}`}>
      <span>{initials}</span>
    </div>
  )}
  <span class="wedge" aria-hidden="true"></span>
</div>

<style>
  .photo-frame {
    position: relative;
    overflow: hidden;
    background: var(--color-gray-tint);
  }
  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(155deg, var(--color-navy) 0%, var(--color-navy) 55%, var(--color-cool-gray) 55%, var(--color-cool-gray) 100%);
  }
  .fallback span {
    font-weight: var(--fw-black);
    font-size: var(--fs-800);
    color: var(--color-white);
  }
  .wedge {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 55%;
    height: 35%;
    background: var(--color-blue);
    opacity: 0.85;
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
  }
</style>
