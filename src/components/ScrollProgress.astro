---
/** Thin fixed bar under the header that fills as the visitor scrolls down
 * the page, and doubles as a navigation-loading bar: clicking an internal
 * link eases it toward ~85% right away, giving instant feedback for the
 * real full-page load that's about to happen (the site is a classic MPA,
 * not a client-router SPA, so there's no "navigation finished" event to
 * animate to 100% on - the browser just replaces the page, which is itself
 * the natural end of the animation). */
---

<div class="scroll-progress" aria-hidden="true">
  <div class="scroll-progress-bar" id="scroll-progress-bar"></div>
</div>

<script>
  const bar = document.getElementById('scroll-progress-bar');
  if (bar) {
    const update = () => {
      const doc = document.documentElement;
      const scrollable = doc.scrollHeight - doc.clientHeight;
      const pct = scrollable > 0 ? (doc.scrollTop / scrollable) * 100 : 0;
      bar.style.width = `${Math.min(100, Math.max(0, pct))}%`;
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();

    // bfcache restore can bring back a page whose bar was mid-"loading"
    // animation when the visitor navigated away from it.
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) update();
    });

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const link = (event.target as HTMLElement)?.closest<HTMLAnchorElement>('a[href]');
        if (!link || event.defaultPrevented) return;
        if (link.target && link.target !== '_self') return;
        if (link.hasAttribute('download')) return;

        const url = new URL(link.href, location.href);
        if (url.origin !== location.origin) return;
        if (url.protocol !== 'http:' && url.protocol !== 'https:') return;
        if (url.pathname === location.pathname && url.search === location.search && url.hash) return;

        bar.classList.add('is-loading');
        requestAnimationFrame(() => {
          bar.style.width = '85%';
        });
      });
    }
  }
</script>

<style>
  .scroll-progress {
    position: sticky;
    top: 0;
    z-index: 51;
    height: 3px;
    background: transparent;
  }
  .scroll-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--color-blue), var(--color-light-blue));
    transition: width 100ms linear;
  }
  .scroll-progress-bar.is-loading {
    transition: width 500ms var(--ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-progress-bar {
      transition: none;
    }
  }
</style>
