---
/**
 * Award card gallery item. Shows the confirmed winner's own member photo
 * (reusing PhotoOverlay, same crop/fallback treatment as the rest of the
 * site) when one exists; otherwise a polished "winner to be announced"
 * state - never a stock photo, an invented name, or a card that implies a
 * decision has been made.
 */
import type { Award } from '../data/types';
import { people } from '../data/people';
import PhotoOverlay from './PhotoOverlay.astro';
import AwardIcon from './AwardIcon.astro';
import Tag from './Tag.astro';
import { ui } from '../i18n/ui';
import { pick, localePath } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  award: Award;
  lang: Lang;
}
const { award, lang } = Astro.props;
const t = ui[lang];
const title = pick(award.title, lang);
const description = pick(award.description, lang);
const recipients = award.recipientSlugs.map((s) => people[s]).filter(Boolean);
const winners = award.status === 'confirmed' ? recipients : [];
const primaryWinner = winners[0] ?? null;
const winnerNames = winners.map((w) => w.name).join(' & ');
---

<article class="award-card reveal" data-tilt>
  <div class="photo-zone">
    {primaryWinner ? (
      <PhotoOverlay src={award.image ?? primaryWinner.photo} name={winnerNames} lang={lang} ratio="1 / 1" />
    ) : (
      <div class="pending-photo">
        <AwardIcon name={award.icon} />
        <span>{t.awards.winnerPending}</span>
      </div>
    )}
    <span class="icon-badge" data-confetti aria-hidden="true">
      <span class="icon-badge-inner">
        <AwardIcon name={award.icon} />
        <span class="icon-shine"></span>
      </span>
    </span>
    {award.status === 'draft' && <Tag class="draft-tag">{t.common.draftBadge}</Tag>}
  </div>

  <div class="body">
    <h3>{title}</h3>
    {winners.length > 0 ? (
      <p class="winner-name">{winnerNames}</p>
    ) : (
      <p class="winner-name pending">{t.awards.winnerPending}</p>
    )}
    {description && <p class="description">{description}</p>}
    {award.year && <p class="edition">{award.year}</p>}
    {winners.length > 0 && (
      <p class="profile-link-row">
        {t.awards.awardedTo}{' '}
        {winners.map((w, i) => (
          <>
            <a class="profile-link" href={localePath(lang, `members/${w.slug}/`)}>{w.name}</a>
            {i < winners.length - 1 ? ' & ' : ''}
          </>
        ))}
      </p>
    )}
  </div>
</article>

<style>
  .award-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    border: var(--border-weight) solid var(--color-border);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: box-shadow var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-standard);
  }
  .award-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }

  /* ---- One-time golden celebration ----
   * The first medal a visitor ever clicks adds this class to its card
   * (see BaseLayout's [data-confetti] handler) - a warm glow that rises
   * and settles back to the card's normal surface, celebrating the
   * discovery without permanently changing anything.
   */
  .award-card.first-celebration {
    animation: golden-glow 1.6s var(--ease-out);
  }
  @keyframes golden-glow {
    0% {
      background-color: var(--color-surface);
      box-shadow: var(--shadow-sm);
    }
    25% {
      background-color: #fff4d6;
      box-shadow: 0 0 0 3px #ffd34d, 0 0 40px 10px rgba(255, 196, 0, 0.5);
    }
    100% {
      background-color: var(--color-surface);
      box-shadow: var(--shadow-sm);
    }
  }

  .photo-zone {
    position: relative;
  }

  .pending-photo {
    aspect-ratio: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background: repeating-linear-gradient(
      135deg,
      var(--color-bg-muted),
      var(--color-bg-muted) 10px,
      var(--color-surface) 10px,
      var(--color-surface) 20px
    );
    color: var(--color-text-muted);
    border-bottom: var(--border-weight) solid var(--color-border);
  }
  .pending-photo :global(.award-icon) {
    width: 32px;
    height: 32px;
    opacity: 0.6;
  }
  .pending-photo span {
    font-size: var(--fs-100);
    font-weight: var(--fw-heading);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ---- Medal badge ----
     A circular medal (.icon-badge-inner) with two ribbon-tail flags
     peeking out from behind it (.icon-badge::before/::after) - the award
     icon's usual square corner badge, redrawn as an actual medal since
     this section is explicitly the fun/lighthearted one on the site.
     Clicking it bursts a small confetti shower (see BaseLayout's
     [data-confetti] handler); hovering the whole card sweeps a shine
     across it and the award icon itself gets the sitewide wiggle. */
  .icon-badge {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    width: 38px;
    height: 38px;
    z-index: 2;
    cursor: pointer;
  }
  /* Drop-in entrance: the medal falls into place and settles with a
     little bounce once the card scrolls into view, slightly after the
     card itself starts fading in. Progressive enhancement, same html.js
     gate as .reveal - without JS the medal is just there, no animation. */
  html.js .award-card.reveal .icon-badge {
    opacity: 0;
    transform: translateY(-46px) rotate(-18deg);
  }
  html.js .award-card.reveal.is-visible .icon-badge {
    animation: medal-drop 0.75s cubic-bezier(0.17, 0.89, 0.32, 1.49) 0.25s both;
  }
  @keyframes medal-drop {
    0% {
      opacity: 0;
      transform: translateY(-46px) rotate(-18deg);
    }
    55% {
      opacity: 1;
      transform: translateY(5px) rotate(5deg);
    }
    78% {
      transform: translateY(-3px) rotate(-2deg);
    }
    100% {
      opacity: 1;
      transform: translateY(0) rotate(0deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .award-card.reveal .icon-badge {
      opacity: 1;
      transform: none;
    }
    html.js .award-card.reveal.is-visible .icon-badge {
      animation: none;
    }
  }
  .icon-badge::before,
  .icon-badge::after {
    content: '';
    position: absolute;
    top: 24px;
    width: 12px;
    height: 20px;
    z-index: -1;
    clip-path: polygon(0 0, 100% 0, 100% 72%, 50% 100%, 0 72%);
  }
  .icon-badge::before {
    left: 1px;
    background: var(--color-blue);
    transform: rotate(16deg);
  }
  .icon-badge::after {
    right: 1px;
    background: var(--color-light-blue);
    transform: rotate(-16deg);
  }
  .icon-badge-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-navy);
    color: var(--color-white);
    box-shadow: var(--shadow-md);
  }
  .icon-shine {
    position: absolute;
    inset: -60%;
    background: linear-gradient(120deg, transparent 42%, rgba(255, 255, 255, 0.55) 50%, transparent 58%);
    transform: translateX(-130%);
    transition: transform 0.7s var(--ease-out);
  }
  .award-card:hover .icon-shine {
    transform: translateX(130%);
  }

  .draft-tag {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    background: var(--color-surface);
    color: var(--color-text-muted);
    box-shadow: var(--shadow-sm);
  }

  .body {
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }
  .body h3 {
    margin: 0;
    color: var(--color-text-muted);
    font-weight: var(--fw-heading);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: var(--fs-100);
  }
  .winner-name {
    font-size: var(--fs-500);
    font-weight: var(--fw-heading);
    color: var(--color-text);
    margin: 0;
  }
  .winner-name.pending {
    color: var(--color-text-muted);
    font-style: italic;
    font-weight: var(--fw-medium);
  }
  .description {
    color: var(--color-text-muted);
    font-size: var(--fs-200);
    margin: 0;
  }
  .edition {
    color: var(--color-text-muted);
    font-size: var(--fs-100);
    margin: 0;
  }
  .profile-link-row {
    margin-top: var(--space-1);
    font-size: var(--fs-200);
    font-weight: var(--fw-medium);
    color: var(--color-text-muted);
  }
  .profile-link {
    font-weight: var(--fw-heading);
    text-decoration: none;
    color: var(--color-accent-strong);
  }
</style>
