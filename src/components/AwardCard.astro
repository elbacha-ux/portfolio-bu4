---
import type { Award } from '../data/types';
import { people } from '../data/people';
import Tag from './Tag.astro';
import { ui } from '../data/ui-strings';

interface Props {
  award: Award;
}
const { award } = Astro.props;
const base = import.meta.env.BASE_URL;
const recipients = award.recipientSlugs.map((s) => people[s]).filter(Boolean);
---

<article class="award-card card">
  <div class="top">
    <h3>{award.title}</h3>
    {award.status === 'draft' && <Tag class="draft-tag">{ui.draftBadge}</Tag>}
  </div>
  {award.description && <p>{award.description}</p>}
  {recipients.length > 0 ? (
    <p class="recipient">
      Awarded to {recipients.map((r, i) => (
        <>
          <a href={`${base}members/${r.slug}/`}>{r.name}</a>{i < recipients.length - 1 ? ', ' : ''}
        </>
      ))}
    </p>
  ) : (
    <p class="recipient pending">Winner to be confirmed by the team.</p>
  )}
</article>

<style>
  .award-card {
    height: 100%;
  }
  .top {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }
  h3 {
    font-size: var(--fs-500);
    margin: 0;
  }
  .draft-tag {
    background: var(--color-gray-tint);
    color: var(--color-cool-gray);
    flex-shrink: 0;
  }
  .recipient {
    font-size: var(--fs-200);
    font-weight: var(--fw-medium);
    color: var(--color-navy);
    margin-top: var(--space-2);
    margin-bottom: 0;
  }
  .recipient.pending {
    color: var(--color-cool-gray);
    font-weight: var(--fw-regular);
    font-style: italic;
  }
  .recipient a {
    color: var(--color-navy);
  }
</style>
