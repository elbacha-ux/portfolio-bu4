---
import type { CollectiveProject } from '../data/types';
import { people } from '../data/people';
import Tag from './Tag.astro';
import { ui } from '../i18n/ui';
import { pick, pickAll, localePath } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  project: CollectiveProject;
  lang: Lang;
}
const { project, lang } = Astro.props;
const t = ui[lang];
const members = project.memberSlugs.map((s) => people[s]).filter(Boolean);
const title = pick(project.title, lang);
const description = pick(project.description, lang);
const category = pick(project.category, lang);
const tools = pickAll(project.tools, lang);
const detailHref = localePath(lang, `projects/${project.slug}/`);
---

<article class="project-card card reveal">
  {project.image && <img src={project.image} alt={project.imageAlt ? pick(project.imageAlt, lang) ?? '' : ''} loading="lazy" width="480" height="300" />}
  <div class="body">
    <div class="meta">
      {category && <Tag>{category}</Tag>}
      {project.status === 'in-progress' && <Tag class="status-tag">{t.common.inProgress}</Tag>}
    </div>
    <h3><a class="card-link" href={detailHref} data-sound="click">{title}</a></h3>
    {description && <p>{description}</p>}
    <div class="card-actions">
      {project.link && (
        <a class="visit-link" href={project.link} target="_blank" rel="noopener noreferrer" data-sound="click">
          {t.projects.visitSite}
          <span class="visit-arrow" aria-hidden="true">↗</span>
        </a>
      )}
      <a class="details-link" href={detailHref}>{t.projects.viewDetails}</a>
    </div>
    {members.length > 0 && (
      <p class="contributors">
        {t.projects.contributorsPrefix} {members.map((m, i) => (
          <>
            <a href={localePath(lang, `members/${m.slug}/`)}>{m.name}</a>{i < members.length - 1 ? ', ' : ''}
          </>
        ))}
      </p>
    )}
    {tools.length > 0 && (
      <ul class="tools">
        {tools.map((tool) => <li>{tool}</li>)}
      </ul>
    )}
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .card-link {
    color: inherit;
    text-decoration: none;
  }
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .card-link:hover {
    text-decoration: underline;
  }
  .project-card img {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    margin: calc(var(--space-3) * -1) calc(var(--space-3) * -1) var(--space-3);
    width: calc(100% + var(--space-3) * 2);
  }
  .meta {
    display: flex;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
  }
  .status-tag {
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }
  h3 {
    font-size: var(--fs-500);
    margin-bottom: var(--space-1);
  }
  .card-actions {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .visit-link,
  .details-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: var(--fs-200);
    font-weight: var(--fw-heading);
    color: var(--color-accent-strong);
    text-decoration: none;
  }
  .visit-link:hover,
  .details-link:hover {
    text-decoration: underline;
  }
  .visit-arrow {
    transition: transform var(--duration-fast) var(--ease-standard);
  }
  .visit-link:hover .visit-arrow {
    transform: translate(2px, -2px);
  }
  .contributors {
    position: relative;
    z-index: 2;
    font-size: var(--fs-200);
    color: var(--color-text-muted);
  }
  .contributors a {
    position: relative;
    z-index: 2;
  }
  .tools {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: var(--space-2) 0 0;
  }
  .tools li {
    font-size: var(--fs-100);
    color: var(--color-text-muted);
    background: var(--color-bg-muted);
    padding: 0.2em 0.5em;
  }
</style>
