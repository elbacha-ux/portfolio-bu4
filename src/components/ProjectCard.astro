---
import type { CollectiveProject } from '../data/types';
import { people } from '../data/people';
import Tag from './Tag.astro';
import { ui } from '../i18n/ui';
import { pick, pickAll, localePath } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  project: CollectiveProject;
  lang: Lang;
}
const { project, lang } = Astro.props;
const t = ui[lang];
const members = project.memberSlugs.map((s) => people[s]).filter(Boolean);
const title = pick(project.title, lang);
const description = pick(project.description, lang);
const category = pick(project.category, lang);
const tools = pickAll(project.tools, lang);
---

<article class="project-card card reveal">
  {project.image && <img src={project.image} alt={project.imageAlt ? pick(project.imageAlt, lang) ?? '' : ''} loading="lazy" width="480" height="300" />}
  <div class="body">
    <div class="meta">
      {category && <Tag>{category}</Tag>}
      {project.status === 'in-progress' && <Tag class="status-tag">{t.common.inProgress}</Tag>}
    </div>
    <h3>{project.link ? <a href={project.link} target="_blank" rel="noopener noreferrer">{title}</a> : title}</h3>
    {description && <p>{description}</p>}
    {members.length > 0 && (
      <p class="contributors">
        {t.projects.contributorsPrefix} {members.map((m, i) => (
          <>
            <a href={localePath(lang, `members/${m.slug}/`)}>{m.name}</a>{i < members.length - 1 ? ', ' : ''}
          </>
        ))}
      </p>
    )}
    {tools.length > 0 && (
      <ul class="tools">
        {tools.map((tool) => <li>{tool}</li>)}
      </ul>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
  }
  .project-card img {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    margin: calc(var(--space-3) * -1) calc(var(--space-3) * -1) var(--space-3);
    width: calc(100% + var(--space-3) * 2);
  }
  .meta {
    display: flex;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
  }
  .status-tag {
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }
  h3 {
    font-size: var(--fs-500);
    margin-bottom: var(--space-1);
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  .contributors {
    font-size: var(--fs-200);
    color: var(--color-text-muted);
  }
  .tools {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: var(--space-2) 0 0;
  }
  .tools li {
    font-size: var(--fs-100);
    color: var(--color-text-muted);
    background: var(--color-bg-muted);
    padding: 0.2em 0.5em;
  }
</style>
