---
import type { CollectiveProject } from '../data/types';
import { people } from '../data/people';
import Tag from './Tag.astro';

interface Props {
  project: CollectiveProject;
}
const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const members = project.memberSlugs.map((s) => people[s]).filter(Boolean);
---

<article class="project-card card">
  {project.image && <img src={project.image} alt={project.imageAlt ?? ''} loading="lazy" width="480" height="300" />}
  <div class="body">
    <div class="meta">
      {project.category && <Tag>{project.category}</Tag>}
      {project.status === 'in-progress' && <Tag class="status-tag">In progress</Tag>}
    </div>
    <h3>{project.link ? <a href={project.link} target="_blank" rel="noopener noreferrer">{project.title}</a> : project.title}</h3>
    {project.description && <p>{project.description}</p>}
    {members.length > 0 && (
      <p class="contributors">
        By {members.map((m, i) => (
          <>
            <a href={`${base}members/${m.slug}/`}>{m.name}</a>{i < members.length - 1 ? ', ' : ''}
          </>
        ))}
      </p>
    )}
    {project.tools.length > 0 && (
      <ul class="tools">
        {project.tools.map((t) => <li>{t}</li>)}
      </ul>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
  }
  .project-card img {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    margin: calc(var(--space-3) * -1) calc(var(--space-3) * -1) var(--space-3);
    width: calc(100% + var(--space-3) * 2);
  }
  .meta {
    display: flex;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
  }
  .status-tag {
    background: var(--color-blue-tint);
    color: var(--color-navy);
  }
  h3 {
    font-size: var(--fs-500);
    margin-bottom: var(--space-1);
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  .contributors {
    font-size: var(--fs-200);
    color: var(--color-cool-gray);
  }
  .tools {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    margin: var(--space-2) 0 0;
  }
  .tools li {
    font-size: var(--fs-100);
    color: var(--color-cool-gray);
    background: var(--color-gray-tint);
    padding: 0.2em 0.5em;
  }
</style>
