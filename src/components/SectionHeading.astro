---
interface Props {
  eyebrow?: string;
  title: string;
  /** Oversized Montserrat Black numeral motif, e.g. "04" or "01"-"07". */
  numeral?: string;
  align?: 'left' | 'center';
  level?: 'h2' | 'h3';
}
const { eyebrow, title, numeral, align = 'left', level = 'h2' } = Astro.props;
const Tag = level;
---

<div class={`section-heading align-${align}`}>
  {numeral && <span class="numeral" aria-hidden="true">{numeral}</span>}
  <div class="heading-content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <div class="rule-split"><span></span><span></span></div>
    <Tag><slot name="title">{title}</slot></Tag>
    <slot />
  </div>
</div>

<style>
  .section-heading {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .section-heading.align-center {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .section-heading.align-center .rule-split {
    margin-inline: auto;
  }
  .numeral {
    flex-shrink: 0;
    font-size: 3rem;
  }
  .heading-content {
    min-width: 0;
  }
  @media (min-width: 768px) {
    .section-heading {
      gap: var(--space-3);
    }
    .numeral {
      font-size: var(--fs-numeral);
    }
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: var(--fw-heading);
    font-size: var(--fs-200);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-1);
  }
</style>
