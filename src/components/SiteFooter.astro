---
import Logo from './Logo.astro';
import { navRoutes, site } from '../data/site';
import { ui } from '../i18n/ui';
import { localePath } from '../i18n';
import { formatPhone } from '../lib/phone';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
const navItems = navRoutes.map((item) => ({ href: localePath(lang, item.href), label: t.nav[item.key] }));
const phoneDisplay = formatPhone(site.contactPhone);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="brand-mark">
        <Logo width={56} lang={lang} />
        <div class="brand-wordmark">
          <span class="brand-name">{site.fullName}</span>
          <span class="brand-slogan">{t.about.sloganWord1} {t.about.sloganWord2} {t.about.sloganWord3}</span>
        </div>
      </div>
      <p class="affiliation">
        {t.footer.affiliation} <strong>{site.parentOrg}</strong> ({site.parentOrgFull}).
      </p>
    </div>

    <nav aria-label={t.nav.footerLabel}>
      <ul>
        {navItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-contact">
      <p class="label">{t.footer.contactLabel}</p>
      <ul class="contact-list">
        {site.contactPhone && (
          <li><a href={`tel:${site.contactPhone}`}>{phoneDisplay}</a></li>
        )}
        {site.socials.instagram && (
          <li><a href={site.socials.instagram} target="_blank" rel="noopener noreferrer">{t.contact.instagramHandle}</a></li>
        )}
        {site.contactEmail && (
          <li><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></li>
        )}
      </ul>
      {!site.contactPhone && !site.socials.instagram && !site.contactEmail && (
        <p class="muted">{t.footer.noContact}</p>
      )}
      <p class="muted parent-email">
        {site.parentOrg} {t.footer.parentInquiries} <a href={`mailto:${site.parentOrgEmail}`}>{site.parentOrgEmail}</a>
      </p>
    </div>
  </div>

  <div class="container legal">
    <p>&copy; {year} {site.fullName} · {site.parentOrg}. {t.footer.rights}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-charcoal);
    color: var(--color-dark-text);
    margin-top: var(--space-7);
  }

  .footer-grid {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-4);
  }


  .brand-mark {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .brand-wordmark {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
  }
  .brand-name {
    font-size: var(--fs-500);
    font-weight: var(--fw-heading);
    color: var(--color-white);
    letter-spacing: 0.01em;
  }
  .brand-slogan {
    font-size: var(--fs-200);
    font-weight: var(--fw-medium);
    color: var(--color-light-blue);
  }

  .affiliation {
    margin-top: var(--space-2);
    color: #d7d5d5;
    max-width: 40ch;
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  nav a {
    color: var(--color-dark-text);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--color-light-blue);
  }

  .footer-contact .label {
    font-weight: var(--fw-heading);
    margin-bottom: var(--space-1);
  }

  .footer-contact a {
    color: var(--color-light-blue);
  }

  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }

  .muted {
    color: #b8b6b6;
  }

  .parent-email {
    margin-top: var(--space-2);
    font-size: var(--fs-200);
  }

  .legal {
    border-top: 1px solid #55504f;
    padding-block: var(--space-2);
    font-size: var(--fs-200);
    color: #b8b6b6;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
</style>
