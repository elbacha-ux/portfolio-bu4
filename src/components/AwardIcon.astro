---
/** Small line-icon set for award cards - purely decorative, stroke-based to
 * match ThemeToggle's sun/moon icons. */
import type { AwardIconName } from '../data/types';

interface Props {
  name: AwardIconName;
}
const { name } = Astro.props;
---

<svg class="award-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3.5 2" />
    </>
  )}
  {name === 'scissors' && (
    <>
      <circle cx="6" cy="6" r="2.5" />
      <circle cx="6" cy="18" r="2.5" />
      <path d="M8.5 7.5 20 18M20 6 8.5 16.5" />
    </>
  )}
  {name === 'shield' && <path d="M12 3 4.5 6v6c0 4.5 3.1 7.7 7.5 9 4.4-1.3 7.5-4.5 7.5-9V6L12 3Z" />}
  {name === 'megaphone' && (
    <>
      <path d="M3 10v4a1 1 0 0 0 1 1h2l5 4V5L6 9H4a1 1 0 0 0-1 1Z" />
      <path d="M17 8.5a4 4 0 0 1 0 7M20 6a7.5 7.5 0 0 1 0 12" />
    </>
  )}
  {name === 'magnifier' && (
    <>
      <circle cx="10.5" cy="10.5" r="6.5" />
      <path d="M20 20l-4.8-4.8" />
    </>
  )}
  {name === 'wrench' && <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 0 5.4-5.4l-2.8 2.8-2-2 2.8-2.8Z" />}
  {name === 'heart' && <path d="M12 20s-7-4.4-9.5-9A5 5 0 0 1 12 6a5 5 0 0 1 9.5 5c-2.5 4.6-9.5 9-9.5 9Z" />}
  {name === 'wave' && <path d="M2 9c2.5-3 5-3 7.5 0s5 3 7.5 0 5-3 7.5 0M2 15.5c2.5-3 5-3 7.5 0s5 3 7.5 0 5-3 7.5 0" />}
  {name === 'target' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <circle cx="12" cy="12" r="5" />
      <circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'camera' && (
    <>
      <path d="M4 8.5a1.5 1.5 0 0 1 1.5-1.5h2l1-1.5h7l1 1.5h2A1.5 1.5 0 0 1 20 8.5v9A1.5 1.5 0 0 1 18.5 19h-13A1.5 1.5 0 0 1 4 17.5v-9Z" />
      <circle cx="12" cy="13" r="3.2" />
    </>
  )}
  {name === 'spark' && <path d="M13 2 4.5 14h5.5l-1 8 9-12H12.5l.5-8Z" />}
  {name === 'signal' && (
    <>
      <path d="M4.5 16.5a11 11 0 0 1 15 0" />
      <path d="M7.5 19.3a6.8 6.8 0 0 1 9 0" />
      <circle cx="12" cy="21.3" r="1.2" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'laugh' && (
    <>
      <path d="M4 5.8A2.3 2.3 0 0 1 6.3 3.5h11.4A2.3 2.3 0 0 1 20 5.8v7A2.3 2.3 0 0 1 17.7 15H11l-5 4v-4.2A2.3 2.3 0 0 1 4 12.8v-7Z" />
      <path d="M8 8.2c.5 1.7 2 2.8 4 2.8s3.5-1.1 4-2.8" />
    </>
  )}
  {name === 'flask' && (
    <>
      <path d="M9.5 3h5M10 3v5l-4.8 8.3a1.8 1.8 0 0 0 1.6 2.7h10.4a1.8 1.8 0 0 0 1.6-2.7L14 8V3" />
      <path d="M7.7 14.5h8.6" />
    </>
  )}
</svg>

<style>
  .award-icon {
    width: 22px;
    height: 22px;
  }
</style>
