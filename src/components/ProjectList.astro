---
import type { CollectiveProject } from '../data/types';
import ProjectCard from './ProjectCard.astro';
import { ui } from '../i18n/ui';
import type { Lang } from '../i18n';

interface Props {
  projects: CollectiveProject[];
  lang: Lang;
  /** Overrides one card's link/CTA by slug - used for entries that aren't
   * a real `projects/<slug>/` detail page (e.g. the magazine, whose real
   * page is /magazine/). */
  overrideSlug?: string;
  overrideHref?: string;
  overrideCtaLabel?: string;
  overrideImageObjectPosition?: string;
}
const { projects, lang, overrideSlug, overrideHref, overrideCtaLabel, overrideImageObjectPosition } = Astro.props;
const t = ui[lang];
---

{projects.length > 0 ? (
  <ul class="project-list">
    {projects.map((p) => (
      <li>
        <ProjectCard
          project={p}
          lang={lang}
          hrefOverride={p.slug === overrideSlug ? overrideHref : undefined}
          ctaLabelOverride={p.slug === overrideSlug ? overrideCtaLabel : undefined}
          imageObjectPosition={p.slug === overrideSlug ? overrideImageObjectPosition : undefined}
        />
      </li>
    ))}
    <slot />
  </ul>
) : (
  <p class="empty-state">{t.common.noProjectsYet}</p>
)}

<style>
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  @media (min-width: 768px) {
    .project-list {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-4);
    }
  }
  @media (min-width: 1024px) {
    .project-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .empty-state {
    color: var(--color-text-muted);
    font-style: italic;
    padding: var(--space-4) 0;
  }
</style>
