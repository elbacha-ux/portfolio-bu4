---
/**
 * The Projects page's "project book": a closed cover that opens into
 * two-page spreads (one per project, see ProjectSpread.astro), turned with
 * CSS 3D transforms - see src/lib/book.ts for the interaction logic and
 * the long comment at the top of that file for how the page-turn illusion
 * actually works.
 *
 * Progressive enhancement: everything below the cover is normal, readable
 * document flow by default. Only `html.js .project-book` (global.css gate,
 * same pattern as .reveal/fade-in-img elsewhere on the site) arms the
 * closed-book/3D-stack presentation, so a no-JS visitor - or a crawler -
 * just sees a clean stacked list of project spreads, not a locked book.
 */
import type { CollectiveProject } from '../data/types';
import { L } from '../data/types';
import ProjectSpread from './ProjectSpread.astro';
import { ui } from '../i18n/ui';
import { site } from '../data/site';
import { magazine } from '../data/magazine';
import { localePath, pick } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  projects: CollectiveProject[];
  lang: Lang;
}
const { projects, lang } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL;

/**
 * The magazine isn't a CollectiveProject (no members/case study/detail
 * route) - it gets one extra closing page in the book, built from
 * src/data/magazine.ts, that links out to the magazine page instead of a
 * `projects/<slug>/` case study. See ProjectSpread.astro's hrefOverride.
 */
const magazineDescription = `${magazine.subtitle} ${pick(magazine.description[0], lang)}`;
const magazineSpread: CollectiveProject = {
  slug: 'magazine',
  title: L(t.nav.magazine, t.nav.magazine),
  description: L(magazineDescription, magazineDescription),
  category: L(t.magazine.eyebrow, t.magazine.eyebrow),
  status: null,
  memberSlugs: [],
  tools: [],
  skills: [],
  outcome: null,
  link: null,
  image: magazine.cover,
  imageAlt: L(`${t.magazine.coverAltPrefix} "${magazine.title}"`, `${t.magazine.coverAltPrefix} "${magazine.title}"`),
  videoUrl: null,
  documentsNote: null,
  repositoryUrl: null,
  caseStudy: null,
};
const allSpreads = [...projects, magazineSpread];
const total = allSpreads.length;
---

<div class="project-book" data-close-label={t.projects.bookClose} data-prev-label={t.projects.bookPrev}>
  <div class="book-stage">
    <div class="book-ambient" aria-hidden="true"></div>

    <div class="book">
      <button type="button" class="book-cover" data-book-cover aria-label={`${t.projects.bookOpenHint} - ${t.projects.bookCoverTitle}`}>
        <span class="cover-face">
          <span class="cover-grid" aria-hidden="true"></span>
          <span class="cover-linework" aria-hidden="true">
            <img src={`${base}images/projects/book-cover-emblem.jpg`} alt="" />
          </span>
          <span class="cover-text">
            <span class="cover-kicker">
              <span class="cover-kicker-brand">{site.name}</span>
              <span class="cover-kicker-tagline">{site.tagline}</span>
            </span>
            <span class="cover-title">{t.projects.bookCoverTitle}</span>
          </span>
          <span class="cover-spine-edge" aria-hidden="true"></span>
        </span>
        <span class="book-pages-edge" aria-hidden="true"></span>
        <span class="book-open-hint" data-book-hint>{t.projects.bookOpenHint}</span>
      </button>

      <div class="book-pages">
        {allSpreads.map((project, i) =>
          project.slug === 'magazine' ? (
            <ProjectSpread
              project={project}
              lang={lang}
              index={i}
              total={total}
              hrefOverride={localePath(lang, 'magazine/')}
              ctaLabelOverride={t.projects.bookReadMagazine}
              fillPage
            />
          ) : (
            <ProjectSpread project={project} lang={lang} index={i} total={total} />
          )
        )}
      </div>
    </div>
  </div>
</div>

<style>
  .project-book {
    position: relative;
    isolation: isolate;
  }

  /* ---- No-JS / no-html.js fallback: plain stacked spreads ----
     Everything below is normal flow by default. The elaborate closed-book
     presentation only exists once html.js proves scripting is available. */
  .book-stage {
    perspective: none;
  }
  .book-ambient,
  .book-cover {
    display: none;
  }
  .book-pages {
    display: grid;
    gap: var(--space-6);
  }
  /* ---- Enhanced (html.js) book presentation - desktop/tablet only ----
     Below 641px this entire block is skipped, so html.js has no effect
     and the page renders exactly like the no-JS fallback above: a
     plain, fully-readable stacked list. A 3D page-turning book has no
     good touch equivalent - no hover, awkward nested scrolling inside a
     fixed-height box, fiddly corner targets - so rather than patch
     those problems one at a time, mobile just never arms the book at
     all. See the matching @media wrapper in ProjectSpread.astro.
     (The cover/ambient `display: block` override lives inside this
     wrapper too - otherwise it'd flip the cover visible on mobile
     without any of the positioning/sizing rules below to make it look
     right.) */
  @media (min-width: 641px) {
  :global(html.js) .project-book {
    --book-max-w: min(100%, 980px);
  }
  :global(html.js) .book-ambient,
  :global(html.js) .book-cover {
    display: block;
  }
  :global(html.js) .book-stage {
    position: relative;
    max-width: var(--book-max-w);
    margin-inline: auto;
    padding-block: var(--space-6);
    perspective: 2400px;
  }
  .book-ambient {
    position: absolute;
    inset: -10% -5% -5%;
    z-index: -1;
    background: radial-gradient(ellipse 60% 50% at 50% 40%, color-mix(in srgb, var(--color-blue) 22%, transparent), transparent 70%);
    filter: blur(10px);
  }
  :global(html.js) .book {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    transform-style: preserve-3d;
    margin-inline: auto;
  }

  /* ---- Closed cover ---- */
  .book-cover {
    position: absolute;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: flex-end;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    transform-style: preserve-3d;
    transform-origin: left center;
    transform: rotateY(0deg);
    transition: transform 1s cubic-bezier(0.65, 0, 0.35, 1);
    animation: cover-float 7s ease-in-out infinite;
  }
  @keyframes cover-float {
    0%, 100% { transform: rotateY(0deg) translateY(0) rotateX(0deg); }
    50% { transform: rotateY(0deg) translateY(-6px) rotateX(1deg); }
  }
  .is-open .book-cover {
    transform: rotateY(-165deg);
    pointer-events: none;
  }
  /* Closing removes .is-open immediately, which would otherwise let the
     idle cover-float animation below retake the transform property and
     snap it straight to the animation's own keyframe - CSS animations
     don't hand off to a transition, they just win outright the instant
     they're re-enabled, which is why closing looked like an instant cut
     instead of a swing. book.ts adds .is-closing for the swing's
     duration so the animation stays suppressed until the transition
     has actually finished closing the cover. */
  .is-open .book-cover,
  .is-closing .book-cover {
    animation: none;
  }
  .cover-face {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 11% 9% 8%;
    /* A near-black book-cloth look instead of the brand's navy - the
       cover is a standalone "object" sitting on the page, not a brand
       surface, so it can go darker/more neutral than the site's usual
       blue palette. */
    background: linear-gradient(165deg, #1c1c1f 0%, #101012 55%, #050506 100%);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6), 0 2px 0 rgba(255, 255, 255, 0.06) inset;
    backface-visibility: hidden;
    overflow: hidden;
  }
  .cover-face::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, rgba(255, 255, 255, 0.06), transparent 40%);
    pointer-events: none;
  }
  /* Faint woven-cloth texture (two very low-opacity diagonal hatches)
     instead of a blueprint grid - the cover reads as a bound object, not
     a technical drawing, so the texture should feel like cover cloth. */
  .cover-grid {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background-image: repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.035) 0, rgba(255, 255, 255, 0.035) 1px, transparent 1px, transparent 4px),
      repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.035) 0, rgba(255, 255, 255, 0.035) 1px, transparent 1px, transparent 4px);
    mask-image: radial-gradient(ellipse 80% 75% at 50% 45%, black, transparent 90%);
  }
  .cover-spine-edge {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 14px;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.5), transparent);
  }
  .cover-linework {
    position: absolute;
    left: 50%;
    top: 68%;
    transform: translate(-50%, -50%);
    height: 40%;
    width: auto;
    /* Matches the source crop's own proportions (980x620) so the image
       fills this box exactly, no letterboxing or cropping. */
    aspect-ratio: 980 / 620;
  }
  .cover-linework img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover-text {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75em;
    text-align: center;
    color: var(--color-white);
  }
  .cover-kicker {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
  }
  .cover-kicker-brand {
    font-size: var(--fs-200);
    font-weight: var(--fw-black);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #e7e9ec;
  }
  .cover-kicker-tagline {
    font-size: var(--fs-100);
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #aab0b8;
  }
  .cover-title {
    font-size: clamp(1.75rem, 5vw, 3.25rem);
    font-weight: var(--fw-black);
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    max-width: 16ch;
    color: #eef0f2;
    /* A subtle engraved/foil-stamped look - a thin light edge above, a
       soft dark edge below - rather than a flat fill. */
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.12), 0 -1px 1px rgba(0, 0, 0, 0.5);
  }
  /* A brushed-metal gradient on the two foil-stamped lines, with the
     plain light color above as the fallback everywhere this isn't
     supported - the gradient is a pure enhancement, never required for
     the text to read correctly. */
  /* A brushed-metal gradient on the short single-line "BU4" mark - kept
     off the big title below, which wraps to two lines, because
     background-clip:text applies one gradient across the whole text
     block's height, making the second line visibly duller than the
     first instead of reading as one even surface. */
  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .cover-kicker-brand {
      background: linear-gradient(180deg, #ffffff 0%, #dadde1 60%, #b7bbc1 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      -webkit-text-fill-color: transparent;
    }
  }
  .book-pages-edge {
    position: absolute;
    right: -6px;
    top: 2%;
    bottom: 2%;
    width: 10px;
    z-index: 1900;
    background: repeating-linear-gradient(to bottom, #eef0f2 0, #eef0f2 2px, #d7dbe0 2px, #d7dbe0 4px);
    box-shadow: 2px 0 6px rgba(0, 0, 0, 0.25);
    border-radius: 0 2px 2px 0;
  }
  .is-open .book-pages-edge {
    opacity: 0;
  }
  .book-open-hint {
    position: absolute;
    left: 50%;
    bottom: 6%;
    transform: translateX(-50%);
    font-size: var(--fs-100);
    font-weight: var(--fw-heading);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    /* Neutral silver to match the cover's new book-cloth palette - still
       well clear of AA (10.5:1+) against the near-black background. */
    color: #c7ccd2;
    transition: opacity var(--duration-base) var(--ease-standard);
    pointer-events: none;
    /* A slow, gentle breathing motion - not a hard bounce - so the hint
       reads as an invitation to click rather than a distraction. */
    animation: hint-float 2.4s ease-in-out infinite;
  }
  @keyframes hint-float {
    0%, 100% { transform: translateX(-50%) translateY(0); opacity: 1; }
    50% { transform: translateX(-50%) translateY(-5px); opacity: 0.65; }
  }
  .book-open-hint.is-dismissed {
    opacity: 0;
    animation: none;
  }
  .book-cover:hover:not(:disabled),
  .book-cover:focus-visible {
    animation-play-state: paused;
    transform: rotateY(-3deg) rotateX(1deg) translateY(-4px) scale(1.008);
  }

  /* ---- Pages stack ---- */
  :global(html.js) .book-pages {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  /* Every spread sits at opacity 0 while the book is closed - not just
     the non-active ones - because a flat (untransformed) spread and the
     flat closed cover are coplanar inside this preserve-3d stage, and
     z-index doesn't reliably win that tie (it can lose to DOM order),
     which let chapter 1 visibly bleed through the "closed" cover.
     Once open, ALL spreads turn opaque together (not just the active
     one, like before) so the turn is actually visible as pages rotate
     away - z-index + backface-visibility alone decide what's on top
     from then on, which is fine since the cover has rotated clear by
     then and every remaining comparison is pages-vs-pages, where
     z-index and DOM order already agree. */
  :global(html.js) :global(.book-spread) {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform-origin: left center;
    backface-visibility: hidden;
    transform: rotateY(0deg);
    /* Same easing as the cover below (a proven, properly monotonic
       ease-in-out) - an unusual curve tried here earlier had the page
       sit almost still for the first ~40% of the duration then whip
       through the rest, which read as a stutter, not a turn. */
    transition: transform 1s cubic-bezier(0.65, 0, 0.35, 1);
    opacity: 0;
    pointer-events: none;
  }
  :global(html.js) .is-open :global(.book-spread) {
    opacity: 1;
  }
  :global(html.js) .is-open :global(.book-spread.is-active) {
    pointer-events: auto;
  }
  :global(html.js) .is-open :global(.book-spread.is-turned) {
    transform: rotateY(-165deg);
  }
  } /* /@media (min-width: 641px) - enhanced book presentation */

  @media (prefers-reduced-motion: reduce) {
    .book-cover {
      animation: none;
      transition: none;
    }
    .book-open-hint {
      animation: none;
    }
    :global(html.js) :global(.book-spread) {
      transition: none;
    }
  }
</style>

<script>
  import { initProjectBook } from '../lib/book';
  initProjectBook();
</script>
