---
/**
 * Lightweight, dependency-free horizontal bar chart (plain CSS, no SVG/JS
 * charting library). Always renders an accessible text equivalent
 * alongside the visual bars, so the data is available even if styles fail
 * to load or a screen reader skips decorative markup.
 */
interface BarItem {
  label: string;
  value: number;
  max: number;
  /** Shown next to the bar, e.g. "B2" or "C1". */
  valueLabel: string;
}
interface Props {
  items: BarItem[];
  summaryLabel: string;
}
const { items, summaryLabel } = Astro.props;
---

<div class="bar-chart" role="img" aria-label={items.map((i) => `${i.label}: ${i.valueLabel}`).join(', ')}>
  <ul class="bars" aria-hidden="true">
    {items.map((item) => (
      <li class="bar-row">
        <div class="bar-head">
          <span class="bar-label">{item.label}</span>
          <span class="bar-value">{item.valueLabel}</span>
        </div>
        <span class="bar-track">
          <span class="bar-fill" style={`width: ${Math.round((item.value / item.max) * 100)}%`}></span>
        </span>
      </li>
    ))}
  </ul>

  <details class="text-summary">
    <summary>{summaryLabel}</summary>
    <ul>
      {items.map((item) => <li>{item.label}: {item.valueLabel}</li>)}
    </ul>
  </details>
</div>

<script>
  // Replays the grow-from-0 animation every time a bar scrolls into view
  // (not just once), by toggling the class that arms it instead of letting
  // it run unconditionally on page load - see .bar-fill/.in-view below.
  const fills = document.querySelectorAll<HTMLElement>('.bar-fill');
  if (fills.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          entry.target.classList.toggle('in-view', entry.isIntersecting);
        }
      },
      { threshold: 0.4 }
    );
    fills.forEach((fill) => io.observe(fill));
  } else {
    fills.forEach((fill) => fill.classList.add('in-view'));
  }
</script>

<style>
  .bar-chart {
    width: 100%;
  }
  .bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .bar-row {
    display: grid;
    gap: 0.45rem;
  }
  .bar-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .bar-label {
    font-size: var(--fs-200);
    font-weight: var(--fw-medium);
    color: var(--color-text);
    line-height: var(--lh-normal);
  }
  .bar-value {
    flex-shrink: 0;
    font-size: var(--fs-200);
    font-weight: var(--fw-black);
    color: var(--color-accent-strong);
    font-variant-numeric: tabular-nums;
  }
  .bar-track {
    display: block;
    height: 9px;
    border-radius: var(--radius-pill);
    background: var(--color-bg-muted);
    position: relative;
    overflow: hidden;
    box-shadow: inset 0 1px 2px rgba(var(--shadow-color), 0.14);
  }
  .bar-fill {
    display: block;
    height: 100%;
    border-radius: var(--radius-pill);
    background: linear-gradient(90deg, var(--color-blue), var(--color-light-blue));
    box-shadow: 0 0 8px 0 color-mix(in srgb, var(--color-blue) 55%, transparent);
    transform-origin: left;
    transform: scaleX(0);
  }
  .bar-fill.in-view {
    animation: grow-bar var(--duration-slow) var(--ease-out) forwards;
  }
  @keyframes grow-bar {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bar-fill {
      transform: scaleX(1);
    }
    .bar-fill.in-view {
      animation: none;
    }
  }
  .text-summary {
    margin-top: var(--space-2);
  }
  .text-summary summary {
    cursor: pointer;
    font-size: var(--fs-100);
    color: var(--color-text-muted);
    width: fit-content;
  }
  .text-summary ul {
    margin: var(--space-1) 0 0;
    padding-left: 1.2em;
    font-size: var(--fs-200);
    color: var(--color-text-muted);
  }
</style>
