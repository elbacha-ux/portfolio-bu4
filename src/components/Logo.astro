---
/**
 * BU4's own icon mark (the "4" swirl + star) - a unit-level mark derived
 * from JEENISo's visual language, not the JEENISo signature itself. Section
 * 1.4 "Improper use" of docs/brand/Charte-Graphique-1.pdf (never recolor,
 * stretch, rotate, redraw) governs the JEENISo corporate signature
 * specifically and doesn't bind this mark - confirmed by the team, who own
 * it. public/images/brand/bu4-logo-mark.png is a cleaned-up master (same
 * shape and colors as the original docs/brand/logo/logo.jpeg crop, just
 * properly upscaled/denoised from what was a 126x136px source with visible
 * JPEG noise - see git history before 2026-10-18 for the original file).
 * bu4-icon-180.png/bu4-icon-512.png are square-padded crops of the same
 * master, used for the favicon and social-preview fallback.
 */
import { localePath } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  width?: number;
  class?: string;
  lang?: Lang;
}
const { width = 160, class: className, lang = 'en' } = Astro.props;
---

<a href={localePath(lang)} class={`bu4-logo ${className ?? ''}`} aria-label="BU4 home">
  <img
    src={`${import.meta.env.BASE_URL}images/brand/bu4-logo-mark.png`}
    alt="Business Unit 4"
    width={width}
    height={Math.round(width * (136 / 126))}
    style={`width:${width}px; height:auto;`}
  />
</a>

<style>
  .bu4-logo {
    display: inline-flex;
    line-height: 0;
    /* Clear space: at least a quarter of the rendered height on every side. */
    padding: 0.5rem;
    margin: -0.5rem;
  }
</style>
