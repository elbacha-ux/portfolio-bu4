---
/**
 * Loads the approved BU4 signature file unmodified (docs/brand/logo/logo.jpeg,
 * mirrored to public/images/brand/). Never recolor, stretch, rotate or add a
 * background behind it - see docs/brand/Charte-Graphique-1.pdf section 1.4.
 */
interface Props {
  /** Minimum rendered width is 120px per the charter (section 1.3). */
  width?: number;
  class?: string;
}
const { width = 160, class: className } = Astro.props;
---

<a href={`${import.meta.env.BASE_URL}`} class={`bu4-logo ${className ?? ''}`} aria-label="BU4 home">
  <img
    src={`${import.meta.env.BASE_URL}images/brand/bu4-logo.jpg`}
    alt="Business Unit 4 - Challenges are our business"
    width={width}
    height={Math.round(width * 0.34)}
    style={`width:${width}px; height:auto;`}
  />
</a>

<style>
  .bu4-logo {
    display: inline-flex;
    line-height: 0;
    /* Clear space: at least a quarter of the rendered height on every side. */
    padding: 0.5rem;
    margin: -0.5rem;
  }
</style>
