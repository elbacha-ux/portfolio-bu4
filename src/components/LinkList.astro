---
interface LinkItem {
  label: string;
  href: string;
}
interface Props {
  links: LinkItem[];
}
const { links } = Astro.props;
---

{links.length > 0 && (
  <ul class="link-list">
    {links.map((l) => (
      <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a></li>
    ))}
  </ul>
)}

<style>
  .link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .link-list a {
    font-weight: var(--fw-heading);
    text-decoration: none;
    border-bottom: 2px solid var(--color-blue);
  }
</style>
