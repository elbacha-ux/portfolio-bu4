---
import type { Member } from '../data/types';
import MemberCard from './MemberCard.astro';
import { pickAll } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  members: Member[];
  lang: Lang;
}
const { members, lang } = Astro.props;

const toSlug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<ul class="member-grid">
  {members.map((m) => (
    <li data-skills={pickAll(m.skills.technical, lang).map(toSlug).join(' ')}>
      <MemberCard member={m} lang={lang} />
    </li>
  ))}
</ul>

<style>
  /* Mobile: simple 2-column grid. */
  .member-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .member-grid li {
    min-width: 0;
  }

  /* Desktop: fixed 4-column grid (equal width regardless of text length) so
     a trailing row of 3 can be offset to sit centered under columns 2-4. */
  @media (min-width: 768px) {
    .member-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-4);
    }
    .member-grid li:nth-child(5) {
      grid-column-start: 2;
    }
    /* That centering trick is tuned for the full, unfiltered 7-member
       roster - it doesn't generalize to arbitrary filtered counts, so a
       page that filters this grid (see TeamView.astro) can toggle this
       class to drop back to normal left-to-right flow. */
    .member-grid.is-filtered li:nth-child(5) {
      grid-column-start: auto;
    }
  }
</style>
