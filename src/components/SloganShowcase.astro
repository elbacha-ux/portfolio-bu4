---
/**
 * Interactive showcase for the BU4 tagline "Challenges are our business"
 * (verified text: docs/brand/logo/logo.jpeg). The faceted colored shards
 * use only approved charter hues (blue/light-blue/navy/cool-gray/mid-gray -
 * see docs/brand/Charte-Graphique-1.pdf section 2.3, "faceted blue
 * fragments" was listed as allowed decoration in the original brief) - no
 * colors outside that set. The "why" explanation is a real <details>
 * disclosure: keyboard-accessible, works with no JS, no fake controls.
 */
import SignaturePlayer from './SignaturePlayer.astro';
import { ui } from '../i18n/ui';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

// Split each colored chunk into its real words so the slogan can reveal
// word by word (like it's being written) instead of as 3 fixed blocks -
// each word keeps a running index across all three chunks for the
// staggered transition-delay in the <style> below.
let wordIndex = 0;
const toWords = (text: string) => text.split(' ').map((word) => ({ word, i: wordIndex++ }));
const w1 = toWords(t.about.sloganWord1);
const w2 = toWords(t.about.sloganWord2);
const w3 = toWords(t.about.sloganWord3);
---

<section class="slogan-showcase glow-bg reveal" data-spotlight>
  <div class="facets" aria-hidden="true">
    <span class="facet f1" data-parallax="0.06"></span>
    <span class="facet f2" data-parallax="0.12"></span>
    <span class="facet f3" data-parallax="0.09"></span>
    <span class="facet f4" data-parallax="0.14"></span>
    <span class="facet f5" data-parallax="0.07"></span>
    <span class="facet f6" data-parallax="0.18"></span>
  </div>

  <div class="container showcase-inner">
    <p class="eyebrow">{t.about.sloganEyebrow}</p>
    <p class="slogan-text">
      <span class="word w1">{w1.map((p, idx) => <>{idx > 0 && ' '}<span class="word-piece" style={`--i: ${p.i}`}>{p.word}</span></>)}</span>
      {' '}
      <span class="word w2">{w2.map((p, idx) => <>{idx > 0 && ' '}<span class="word-piece" style={`--i: ${p.i}`}>{p.word}</span></>)}</span>
      {' '}
      <span class="word w3">{w3.map((p, idx) => <>{idx > 0 && ' '}<span class="word-piece" style={`--i: ${p.i}`}>{p.word}</span></>)}</span>
    </p>

    <details class="why">
      <summary data-sound="click">
        <span class="plus" aria-hidden="true"></span>
        {t.about.sloganToggle}
      </summary>
      <div class="why-body-wrapper">
        <p class="why-body">{t.about.sloganBody}</p>
      </div>
    </details>

    <div class="signature-row">
      <SignaturePlayer lang={lang} />
    </div>
  </div>
</section>

<style>
  .slogan-showcase {
    position: relative;
    overflow: hidden;
    background: var(--color-navy);
    padding-block: var(--space-7);
    isolation: isolate;
  }

  .facets {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .facet {
    position: absolute;
    display: block;
  }
  .f1 {
    width: 46%;
    height: 140%;
    top: -20%;
    left: -12%;
    background: var(--color-navy-deep);
    clip-path: polygon(0 0, 70% 0, 40% 100%, 0% 100%);
  }
  .f2 {
    width: 30%;
    height: 120%;
    top: -10%;
    left: 8%;
    background: var(--color-blue);
    opacity: 0.5;
    clip-path: polygon(20% 0, 100% 0, 60% 100%, 0 100%);
  }
  .f3 {
    width: 36%;
    height: 160%;
    top: -30%;
    right: -14%;
    background: var(--color-light-blue);
    opacity: 0.35;
    clip-path: polygon(30% 0, 100% 0, 100% 100%, 0 100%);
  }
  .f4 {
    width: 22%;
    height: 90%;
    bottom: -10%;
    right: 10%;
    background: var(--color-cool-gray);
    opacity: 0.3;
    clip-path: polygon(0 0, 100% 20%, 80% 100%, 0% 100%);
  }
  .f5 {
    width: 18%;
    height: 70%;
    bottom: -5%;
    left: 30%;
    background: var(--color-mid-gray);
    opacity: 0.2;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }
  .f6 {
    width: 14%;
    height: 50%;
    top: 10%;
    right: 28%;
    background: var(--color-blue);
    opacity: 0.25;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }

  .showcase-inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: var(--fw-heading);
    font-size: var(--fs-200);
    color: var(--color-light-blue);
    margin-bottom: var(--space-2);
  }

  .slogan-text {
    margin: 0 0 var(--space-4);
    font-family: var(--font-primary);
    font-weight: var(--fw-black);
    line-height: 1.05;
    font-size: clamp(2rem, 7vw, 4.5rem);
  }

  .word {
    display: inline-block;
    padding: 0 0.15em;
    transition: transform var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-standard);
    cursor: default;
  }
  .word-piece {
    display: inline-block;
  }
  /* Written word by word: each piece starts hidden and slides up into
     place once the section is scrolled into view (.reveal/.is-visible from
     BaseLayout's shared observer), staggered by --i across all 3 chunks. */
  html.js .slogan-showcase .word-piece {
    opacity: 0;
    transform: translateY(0.35em);
    transition: opacity var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out);
    transition-delay: calc(var(--i) * 120ms);
  }
  html.js .slogan-showcase.is-visible .word-piece {
    opacity: 1;
    transform: none;
  }
  .word:hover,
  .word:focus-visible {
    transform: translateY(-0.06em) scale(1.04);
  }
  .w1 {
    color: var(--color-white);
  }
  .w1:hover {
    color: var(--color-light-blue);
  }
  .w2 {
    color: var(--color-mid-gray);
  }
  .w2:hover {
    color: var(--color-white);
  }
  .w3 {
    color: var(--color-light-blue);
  }
  .w3:hover {
    color: var(--color-white);
  }

  .why {
    display: inline-block;
    text-align: left;
    max-width: 56ch;
  }

  .why summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
    font-weight: var(--fw-heading);
    color: var(--color-white);
    border: 2px solid var(--color-white);
    padding: 0.7em 1.4em;
    margin-inline: auto;
    width: fit-content;
    transition: background-color var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-out), transform var(--duration-base) var(--ease-out);
  }
  .why summary::-webkit-details-marker {
    display: none;
  }
  .why summary:hover,
  .why summary:focus-visible {
    background: rgba(255, 255, 255, 0.14);
    border-color: var(--color-light-blue);
    transform: translateX(-8px);
  }
  .why summary:active {
    transform: translateX(-8px) scale(0.96);
  }

  .plus {
    position: relative;
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    background: currentColor;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .plus::before {
    left: 0;
    top: 6px;
    width: 14px;
    height: 2px;
  }
  .plus::after {
    left: 6px;
    top: 0;
    width: 2px;
    height: 14px;
  }
  details[open] .plus::before,
  details[open] .plus::after {
    transform: rotate(45deg);
  }

  .why-body-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows var(--duration-slow) var(--ease-out), opacity var(--duration-base) var(--ease-out);
  }
  details[open] .why-body-wrapper {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .why-body {
    overflow: hidden;
    margin: 0 auto;
    padding-top: var(--space-3);
    color: #e7edf2;
    font-size: var(--fs-400);
    max-width: 50ch;
    text-align: center;
    transform: translateX(28px);
    transition: transform var(--duration-slow) var(--ease-out);
  }
  details[open] .why-body {
    transform: translateX(0);
  }

  .signature-row {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .why summary,
    .plus::before,
    .plus::after,
    .why-body-wrapper,
    .why-body {
      transition: none;
    }
    html.js .slogan-showcase .word-piece {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 768px) {
    .why summary,
    .why-body {
      margin-inline: auto;
    }
  }
</style>
