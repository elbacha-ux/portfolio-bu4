---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import MemberGrid from '../../components/MemberGrid.astro';
import Button from '../../components/Button.astro';
import { people } from '../../data/people';
import { team } from '../../data/team';
import { ui } from '../../data/ui-strings';

const members = team.memberSlugs.map((slug) => people[slug]);
const bum = people[team.bumSlug];
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Team" description="The seven members of Business Unit 4 at JEENISo.">
  <section class="container section">
    <SectionHeading numeral="03" eyebrow="The team" title="The seven members of BU4" />
    <p class="lead">Each profile links to a full individual portfolio with skills, projects and interests.</p>
    <MemberGrid members={members} />
  </section>

  <section class="container section bum-teaser">
    <p>Led by <strong>{bum.name}</strong>, Business Unit Manager.</p>
    <Button href={`${base}bum/`} variant="secondary">{ui.meetTheBum}</Button>
  </section>
</BaseLayout>

<style>
  .lead {
    max-width: 60ch;
    margin-bottom: var(--space-4);
    color: var(--color-cool-gray);
  }
  .bum-teaser {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding-top: 0;
  }
  .bum-teaser p {
    margin: 0;
  }
</style>
