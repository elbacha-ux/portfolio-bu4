---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { site } from '../../data/site';
---

<BaseLayout title="Contact" description="Get in touch with Business Unit 4.">
  <section class="container section">
    <SectionHeading numeral="06" eyebrow="Get in touch" title="Contact BU4" />

    {site.contactEmail ? (
      <p class="lead">
        Reach the team directly at <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
      </p>
    ) : (
      <p class="lead">
        BU4 does not yet have a dedicated public contact address. In the meantime, you can reach
        {' '}{site.parentOrg} at <a href={`mailto:${site.parentOrgEmail}`}>{site.parentOrgEmail}</a>,
        or contact a member directly through the links on their
        {' '}<a href={`${import.meta.env.BASE_URL}team/`}>team profile</a>.
      </p>
    )}

    <p class="note">
      This page intentionally has no contact form: the site is static and has no backend to
      receive submissions. Use the e-mail links above instead.
    </p>
  </section>
</BaseLayout>

<style>
  .lead {
    font-size: var(--fs-400);
    max-width: 60ch;
  }
  .note {
    margin-top: var(--space-3);
    color: var(--color-cool-gray);
    font-size: var(--fs-200);
    max-width: 60ch;
  }
</style>
