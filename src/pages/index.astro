---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import MemberGrid from '../components/MemberGrid.astro';
import ProjectList from '../components/ProjectList.astro';
import AwardList from '../components/AwardList.astro';
import BumSpotlight from '../components/BumSpotlight.astro';
import { site } from '../data/site';
import { ui } from '../data/ui-strings';
import { people } from '../data/people';
import { team } from '../data/team';
import { projects } from '../data/projects';
import { awards } from '../data/awards';

const base = import.meta.env.BASE_URL;
const members = team.memberSlugs.map((slug) => people[slug]);
const bum = people[team.bumSlug];
const featuredProjects = projects.slice(0, 3);
const featuredAwards = awards.slice(0, 3);
---

<BaseLayout title={site.fullName} isHome>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{site.parentOrg} &middot; {site.fullName}</p>
        <h1>Seven engineers at ENISo, one business unit.</h1>
        <p class="lead">
          {site.description} We build, learn and ship projects together - from embedded electronics
          to the web platform you're reading this on.
        </p>
        <div class="hero-actions">
          <Button href={`${base}projects/`}>{ui.heroCta}</Button>
          <Button href={`${base}contact/`} variant="secondary">{ui.heroCtaSecondary}</Button>
        </div>
      </div>
      <div class="hero-mark" aria-hidden="true">
        <span class="numeral">04</span>
      </div>
    </div>
  </section>

  <section class="container section">
    <SectionHeading numeral="01" eyebrow="Who we are" title="A team built on JEENISo's engineering culture" />
    <p class="intro-copy">
      BU4 is one of JEENISo's business units - the Junior Enterprise of ENISo (École Nationale
      d'Ingénieurs de Sousse). Our seven members come from different engineering tracks (applied
      computer science, embedded telecommunications, automotive software, industrial electronics)
      and work together on technical projects, from first prototypes to this very website.
    </p>
  </section>

  <section class="container section">
    <SectionHeading numeral="02" eyebrow="Our work" title="Featured projects" />
    <ProjectList projects={featuredProjects} />
    {projects.length > 3 && (
      <div class="section-cta"><Button href={`${base}projects/`} variant="secondary">{ui.seeAllProjects}</Button></div>
    )}
  </section>

  <section class="section-muted">
    <div class="container section">
      <SectionHeading numeral="03" eyebrow="The team" title="Meet the seven members of BU4" />
      <MemberGrid members={members} />
      <div class="section-cta"><Button href={`${base}team/`} variant="secondary">{ui.seeFullTeam}</Button></div>
    </div>
  </section>

  <section class="container section">
    <SectionHeading numeral="" eyebrow="Leadership" title="Business Unit Manager" />
    <BumSpotlight bum={bum} variant="compact" />
  </section>

  <section class="container section">
    <SectionHeading numeral="05" eyebrow="Team culture" title="BU4 Awards" />
    <p class="intro-copy">A friendly, honest way to recognize what makes this team work.</p>
    <AwardList awards={featuredAwards} />
    <div class="section-cta"><Button href={`${base}awards/`} variant="secondary">{ui.seeAllAwards}</Button></div>
  </section>

  <section class="closing">
    <div class="container closing-inner">
      <h2>Want to work with BU4?</h2>
      <p>Explore our projects or get in touch to talk about collaborating.</p>
      <div class="hero-actions">
        <Button href={`${base}projects/`} variant="inverse">{ui.seeAllProjects}</Button>
        <Button href={`${base}contact/`} variant="secondary" class="on-dark">{ui.contactUs}</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: var(--color-blue-tint);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-5);
    align-items: center;
  }
  .hero-copy .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: var(--fw-heading);
    color: var(--color-navy);
    margin-bottom: var(--space-2);
  }
  .hero-copy h1 {
    font-size: var(--fs-800);
    max-width: 16ch;
  }
  .lead {
    font-size: var(--fs-400);
    color: var(--color-text);
    max-width: 55ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .hero-mark {
    display: none;
  }

  .section {
    padding-block: var(--space-6);
  }
  .section-muted {
    background: var(--color-gray-tint);
  }
  .intro-copy {
    max-width: 68ch;
    font-size: var(--fs-400);
    color: var(--color-text);
  }
  .section-cta {
    margin-top: var(--space-4);
  }

  .closing {
    background: var(--color-navy);
    color: var(--color-white);
    text-align: center;
  }
  .closing-inner {
    padding-block: var(--space-6);
  }
  .closing h2 {
    color: var(--color-white);
  }
  .closing .hero-actions {
    justify-content: center;
  }
  .closing :global(.on-dark.btn-secondary) {
    color: var(--color-white);
    border-color: var(--color-white);
  }
  .closing :global(.on-dark.btn-secondary:hover) {
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-white);
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 3fr 1fr;
    }
    .hero-mark {
      display: flex;
      justify-content: flex-end;
    }
    .hero-mark .numeral {
      font-size: 10rem;
      color: var(--color-light-blue);
      opacity: 0.6;
    }
  }
</style>
