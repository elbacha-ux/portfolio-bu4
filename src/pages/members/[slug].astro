---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoOverlay from '../../components/PhotoOverlay.astro';
import Tag from '../../components/Tag.astro';
import LinkList from '../../components/LinkList.astro';
import Placeholder from '../../components/Placeholder.astro';
import { people } from '../../data/people';
import { team } from '../../data/team';
import { ui } from '../../data/ui-strings';

export function getStaticPaths() {
  return team.memberSlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const member = people[slug as string];
const base = import.meta.env.BASE_URL;

const links = [
  member.links.email ? { label: 'Email', href: `mailto:${member.links.email}` } : null,
  member.links.linkedin ? { label: 'LinkedIn', href: member.links.linkedin } : null,
  member.links.github ? { label: 'GitHub', href: member.links.github } : null,
].filter((l): l is { label: string; href: string } => l !== null);

const others = team.memberSlugs.filter((s) => s !== slug).map((s) => people[s]);
---

<BaseLayout title={member.name} description={member.intro ?? `${member.name} - BU4 member profile.`}>
  <article class="container member-page">
    <a class="back-link" href={`${base}team/`}>{ui.backToTeam}</a>

    <header class="member-header">
      <div class="photo-col">
        <PhotoOverlay src={member.photo} alt={member.photoAlt} name={member.name} ratio="4 / 5" />
      </div>
      <div class="header-copy">
        <h1>{member.name}</h1>
        {member.specialty && <p class="specialty">{member.specialty}</p>}
        {member.intro ? <p class="intro">{member.intro}</p> : <Placeholder label="personal introduction" />}
        <LinkList links={links} />
      </div>
    </header>

    <div class="member-body">
      <section>
        <h2>Education</h2>
        {member.education ? (
          <div class="education">
            {member.education.program && <p><strong>{member.education.program}</strong>{member.education.institution && `, ${member.education.institution}`}</p>}
            {member.education.years && <p class="muted">{member.education.years}</p>}
            {member.education.degrees.length > 0 && (
              <ul>{member.education.degrees.map((d) => <li>{d}</li>)}</ul>
            )}
            {member.education.certifications.length > 0 && (
              <>
                <p class="label">Additional training</p>
                <ul>{member.education.certifications.map((c) => <li>{c}</li>)}</ul>
              </>
            )}
          </div>
        ) : (
          <Placeholder label="education" />
        )}
      </section>

      <section>
        <h2>Skills & languages</h2>
        {(member.skills.technical.length > 0 || member.skills.personal.length > 0) ? (
          <>
            {member.skills.technical.length > 0 && (
              <div class="tag-group">
                {member.skills.technical.map((s) => <Tag>{s}</Tag>)}
              </div>
            )}
            {member.skills.personal.length > 0 && (
              <ul class="soft-skills">{member.skills.personal.map((s) => <li>{s}</li>)}</ul>
            )}
            {member.skills.languages.length > 0 && (
              <p class="languages">
                {member.skills.languages.map((l) => `${l.name}${l.level ? ` (${l.level})` : ''}`).join(' · ')}
              </p>
            )}
          </>
        ) : (
          <Placeholder label="skills" />
        )}
      </section>

      {member.interests.length > 0 && (
        <section>
          <h2>Interests</h2>
          <ul>{member.interests.map((i) => <li>{i}</li>)}</ul>
        </section>
      )}

      <section>
        <h2>Projects</h2>
        {member.projects.length > 0 ? (
          <ul class="project-items">
            {member.projects.map((p) => (
              <li class="project-item">
                <div class="project-item-head">
                  <h3>{p.title}</h3>
                  {p.status === 'in-progress' && <Tag class="status-tag">In progress</Tag>}
                </div>
                {p.description && <p>{p.description}</p>}
                {p.role && <p class="muted"><strong>Role:</strong> {p.role}</p>}
                {p.tools.length > 0 && <p class="muted"><strong>Tools:</strong> {p.tools.join(', ')}</p>}
                {p.result && <p class="muted"><strong>Result:</strong> {p.result}</p>}
              </li>
            ))}
          </ul>
        ) : (
          <Placeholder label="projects" />
        )}
      </section>

      {member.experience.length > 0 && (
        <section>
          <h2>Experience & activities</h2>
          <ul>
            {member.experience.map((e) => (
              <li><strong>{e.organization}</strong>{e.detail && ` — ${e.detail}`}</li>
            ))}
          </ul>
        </section>
      )}

      {(member.goals.shortTerm || member.goals.longTerm) && (
        <section>
          <h2>Goals</h2>
          {member.goals.shortTerm && <p><strong>Short term:</strong> {member.goals.shortTerm}</p>}
          {member.goals.longTerm && <p><strong>Long term:</strong> {member.goals.longTerm}</p>}
        </section>
      )}
    </div>

    <nav class="other-members" aria-label={ui.otherMembers}>
      <h2>{ui.otherMembers}</h2>
      <ul>
        {others.map((m) => (
          <li><a href={`${base}members/${m.slug}/`}>{m.name}</a></li>
        ))}
      </ul>
    </nav>
  </article>
</BaseLayout>

<style>
  .member-page {
    padding-block: var(--space-4) var(--space-7);
  }
  .back-link {
    display: inline-block;
    margin-bottom: var(--space-3);
    font-weight: var(--fw-medium);
    text-decoration: none;
  }
  .member-header {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .photo-col {
    max-width: 320px;
  }
  .specialty {
    color: var(--color-navy);
    font-weight: var(--fw-heading);
    margin-top: -0.5rem;
  }
  .intro {
    font-size: var(--fs-400);
    max-width: 60ch;
  }
  .member-body {
    display: grid;
    gap: var(--space-5);
  }
  .member-body h2 {
    font-size: var(--fs-600);
    border-bottom: var(--rule-weight) solid var(--color-blue);
    padding-bottom: var(--space-1);
    display: inline-block;
  }
  .label {
    font-weight: var(--fw-heading);
    margin-top: var(--space-2);
    margin-bottom: var(--space-1);
  }
  .muted {
    color: var(--color-cool-gray);
  }
  .tag-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-2);
  }
  .soft-skills {
    margin-bottom: var(--space-2);
  }
  .languages {
    font-weight: var(--fw-medium);
  }
  .project-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .project-item {
    border-left: 3px solid var(--color-mid-gray);
    padding-left: var(--space-2);
  }
  .project-item-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .project-item h3 {
    font-size: var(--fs-500);
    margin: 0;
  }
  .status-tag {
    background: var(--color-blue-tint);
    color: var(--color-navy);
  }
  .other-members {
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .other-members h2 {
    font-size: var(--fs-500);
  }
  .other-members ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }
  .other-members a {
    font-weight: var(--fw-medium);
    text-decoration: none;
  }

  @media (min-width: 768px) {
    .member-header {
      grid-template-columns: 280px 1fr;
    }
  }
</style>
