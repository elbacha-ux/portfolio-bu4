---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BackToTop from '../components/BackToTop.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import EasterEgg from '../components/EasterEgg.astro';
import { site } from '../data/site';
import { ui } from '../i18n/ui';
import { swapLangInPath, otherLang } from '../i18n';
import type { Lang } from '../i18n';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Set true on the homepage so the title isn't duplicated with the site name. */
  isHome?: boolean;
  noindex?: boolean;
  /** Site-root-relative path, with `import.meta.env.BASE_URL` already
   * prepended by the caller (unlike Member.photo/CollectiveProject.image,
   * which are base-relative and need that prefix added before use) - a
   * real content photo for this specific page, a member's portrait, a
   * project's cover. Falls back to the generic BU4 logo mark when absent,
   * so a shared link still gets a reasonable preview either way. */
  image?: string;
}

const { lang, title, description = site.description[lang], isHome = false, noindex = false, image } = Astro.props;
const t = ui[lang];
const pageTitle = isHome ? `${site.fullName} - ${site.parentOrg}` : `${title} - ${site.fullName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const altPath = swapLangInPath(Astro.url.pathname, otherLang(lang));
const ogImageURL = new URL(image ?? `${import.meta.env.BASE_URL}images/brand/bu4-icon-512.png`, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={otherLang(lang)} href={new URL(altPath, Astro.site)} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}images/brand/bu4-icon-180.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    <meta name="generator" content={Astro.generator} />

    <script is:inline define:vars={{ lang, altPath }}>
      // Runs synchronously before first paint: sets the theme (no flash of
      // the wrong theme) and the js class (arms scroll-reveal), and
      // redirects to the visitor's saved language if it differs from this
      // page's language - preserving the exact same page, not just home.
      (function () {
        document.documentElement.classList.add('js');
        try {
          var savedTheme = localStorage.getItem('bu4-theme');
          var theme = savedTheme === 'light' || savedTheme === 'dark'
            ? savedTheme
            : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          /* storage/matchMedia unavailable - CSS prefers-color-scheme fallback still applies */
        }
        try {
          var savedLang = localStorage.getItem('bu4-lang');
          if (savedLang && savedLang !== lang && (savedLang === 'en' || savedLang === 'fr')) {
            location.replace(altPath);
          }
        } catch (e) {
          /* storage unavailable - stay on the default-locale page */
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{t.common.skipToContent}</a>
    <ScrollProgress />
    <SiteHeader lang={lang} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <BackToTop lang={lang} />
    <EasterEgg lang={lang} />
    <script>
      import { initTilt } from '../lib/tilt';
      import { initSpotlight } from '../lib/spotlight';
      import { initParallax } from '../lib/parallax';
      import { initCursor } from '../lib/cursor';
      import { initMagnetic } from '../lib/magnetic';
      initTilt();
      initSpotlight();
      initParallax();
      initCursor();
      initMagnetic();
    </script>
    <script>
      // Scroll-reveal: progressive enhancement only - .reveal elements are
      // fully visible without this (see the html.js gate in global.css).
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      if (items.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );
        items.forEach((item) => io.observe(item));
      } else {
        items.forEach((item) => item.classList.add('is-visible'));
      }
    </script>
    <script>
      // Content photos fade in once actually loaded instead of popping in -
      // scoped to <main> so header/footer chrome (logo) never flashes.
      // Same progressive-enhancement gate as scroll-reveal: fully visible
      // without this.
      const photos = document.querySelectorAll<HTMLImageElement>('main img');
      photos.forEach((img) => {
        img.classList.add('fade-in-img');
        if (img.complete) {
          img.classList.add('is-loaded');
        } else {
          img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
        }
      });
    </script>
    <script>
      // One delegated listener handles every `data-sound` trigger on the
      // page (and any added later, e.g. inside a <details> that opens) -
      // this is the "reusable module, not a separate implementation per
      // page" the sound design calls for. Components just add
      // data-sound="click|confirm|whoosh" to a button/summary; nothing else
      // to wire up.
      import { sound } from '../lib/sound-manager';

      sound.init();

      document.addEventListener('click', (event) => {
        const trigger = (event.target as HTMLElement)?.closest<HTMLElement>('[data-sound]');
        if (!trigger) return;
        const kind = trigger.dataset.sound;
        if (kind === 'click') sound.click();
        else if (kind === 'confirm') sound.confirm();
        else if (kind === 'whoosh') sound.whoosh();
      });

      // Same delegation pattern for hover - data-sound-hover="true" on a
      // photo frame. mouseover bubbles (mouseenter doesn't), so a
      // relatedTarget check keeps this firing once per real entry instead
      // of on every move between child elements.
      document.addEventListener('mouseover', (event) => {
        const trigger = (event.target as HTMLElement)?.closest<HTMLElement>('[data-sound-hover]');
        if (!trigger) return;
        const related = (event as MouseEvent).relatedTarget as Node | null;
        if (related && trigger.contains(related)) return;
        sound.hover();
      });
    </script>
    <script>
      // Delegated handler for [data-confetti] (currently just the award
      // medal badges) - a small, localized burst centered on whatever was
      // clicked, same confetti module as the BU4-signature easter egg, plus
      // a golden glow on that card every time. The remove-reflow-add dance
      // forces the CSS animation to restart even on rapid repeated clicks
      // (just re-adding a class that's already present wouldn't replay it).
      import { burstConfetti } from '../lib/confetti';
      import { sound } from '../lib/sound-manager';

      document.addEventListener('click', (event) => {
        const trigger = (event.target as HTMLElement)?.closest<HTMLElement>('[data-confetti]');
        if (!trigger) return;
        const rect = trigger.getBoundingClientRect();
        burstConfetti(rect.left + rect.width / 2, rect.top + rect.height / 2);
        sound.tada();

        const card = trigger.closest<HTMLElement>('.award-card');
        if (card) {
          card.classList.remove('celebration-glow');
          void card.offsetWidth; // force reflow so the animation restarts
          card.classList.add('celebration-glow');
          card.addEventListener('animationend', () => card.classList.remove('celebration-glow'), { once: true });
        }
      });
    </script>
  </body>
</html>
