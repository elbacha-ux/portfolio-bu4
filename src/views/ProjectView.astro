---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';
import { people } from '../data/people';
import { projects } from '../data/projects';
import { ui } from '../i18n/ui';
import { pick, pickAll, localePath } from '../i18n';
import { projectGallery, hasProjectVideo, projectDocuments, documentPreviewImages } from '../lib/projectMedia';
import { formatFileSize } from '../lib/cv';
import ShareButtons from '../components/ShareButtons.astro';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const t = ui[lang];
const project = projects.find((p) => p.slug === slug)!;

const title = pick(project.title, lang) ?? project.slug;
const description = pick(project.description, lang);
const category = pick(project.category, lang);
const outcome = pick(project.outcome, lang);
const tools = pickAll(project.tools, lang);
const skills = pickAll(project.skills, lang);
const documentsNote = pick(project.documentsNote, lang);
const members = project.memberSlugs.map((s) => people[s]).filter(Boolean);

const cs = project.caseStudy;
const overview = cs ? pick(cs.overview, lang) : null;
const designPhilosophy = cs ? pick(cs.designPhilosophy, lang) : null;
const technicalImplementation = cs ? pick(cs.technicalImplementation, lang) : null;
const keyFeaturesDone = cs ? pickAll(cs.keyFeaturesDone, lang) : [];
const keyFeaturesInProgress = cs ? pickAll(cs.keyFeaturesInProgress, lang) : [];
const challengesAndDecisions = cs ? pick(cs.challengesAndDecisions, lang) : null;
const currentProgress = cs ? pick(cs.currentProgress, lang) : null;

const gallery = projectGallery(slug);
const hasVideo = hasProjectVideo(slug);
const base = import.meta.env.BASE_URL;
const videoSrc = hasVideo ? `${base}videos/${slug}.mp4` : null;

const documents = projectDocuments(slug).map((doc) => ({
  ...doc,
  previewImages: documentPreviewImages(slug, doc.label),
}));
const hasLightbox = gallery.length > 0 || documents.some((d) => d.previewImages.length > 0);

// The magazine has no /projects/<slug>/ page of its own (see
// src/pages/projects/[slug].astro's getStaticPaths) - excluded here too so
// this list never links to a page that doesn't exist.
const otherProjects = projects.filter((p) => p.slug !== slug && p.slug !== 'magazine');

// Falls back to the project's first gallery photo as the share-preview
// image when no dedicated cover was set - same "real photo beats generic
// logo" goal as the member pages (see BaseLayout's `image` prop).
const ogImage = project.image ? `${base}${project.image}` : gallery.length > 0 ? `${base}${gallery[0]}` : undefined;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout lang={lang} title={title} description={description ?? title} image={ogImage}>
  <header class="project-hero glow-bg" data-spotlight>
    <div class="facets" aria-hidden="true">
      <span class="facet f1" data-parallax="0.09"></span>
      <span class="facet f2" data-parallax="0.15"></span>
    </div>
    <div class="container hero-content reveal">
      <div class="meta">
        {category && <Tag>{category}</Tag>}
        {project.status === 'in-progress' && <Tag class="status-tag">{t.common.inProgress}</Tag>}
      </div>
      <h1 style={`view-transition-name: project-title-${project.slug}`}>{title}</h1>
      {description && <p class="lead">{description}</p>}
      <div class="hero-actions">
        {project.link && (
          <a class="btn btn-primary" href={project.link} target="_blank" rel="noopener noreferrer" data-sound="click">
            {t.projects.visitSite}
            <span aria-hidden="true">↗</span>
          </a>
        )}
        {project.repositoryUrl && (
          <a class="btn btn-secondary" href={project.repositoryUrl} target="_blank" rel="noopener noreferrer" data-sound="click">
            {t.projects.sourceCode}
            <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>
  </header>

  <nav class="section-nav" aria-label={t.projects.title}>
    <div class="container section-nav-inner">
      <a class="back-link" href={localePath(lang, 'projects/')}>{t.common.backToProjects}</a>
      <div class="section-nav-share">
        <ShareButtons url={pageUrl} title={title} lang={lang} />
      </div>
    </div>
  </nav>

  <article class="container project-page">
    {(videoSrc || project.videoUrl) && (
      <section id="video" class="reveal">
        <h2>{t.projects.videoTitle}</h2>
        {videoSrc ? (
          <video autoplay muted playsinline controls preload="metadata" class="project-video">
            <source src={videoSrc} type="video/mp4" />
          </video>
        ) : (
          <a class="btn btn-secondary" href={project.videoUrl!} target="_blank" rel="noopener noreferrer" data-sound="click">
            {t.projects.videoTitle}
            <span aria-hidden="true">↗</span>
          </a>
        )}
      </section>
    )}

    {overview && (
      <section class="reveal">
        <h2>{t.projects.aboutTitle}</h2>
        <p>{overview}</p>
      </section>
    )}

    {members.length > 0 && (
      <section class="reveal">
        <h2>{t.projects.contributorsTitle}</h2>
        <ul class="contributors-list">
          {members.map((m) => (
            <li><a href={localePath(lang, `members/${m.slug}/`)}>{m.name}</a></li>
          ))}
        </ul>
      </section>
    )}

    {tools.length > 0 && (
      <section class="reveal">
        <h2>{t.projects.toolsTitle}</h2>
        <div class="tag-group">
          {tools.map((tool) => <Tag>{tool}</Tag>)}
        </div>
      </section>
    )}

    {skills.length > 0 && (
      <section class="reveal">
        <h2>{t.projects.skillsTitle}</h2>
        <div class="tag-group">
          {skills.map((skill) => <Tag>{skill}</Tag>)}
        </div>
      </section>
    )}

    {designPhilosophy && (
      <section class="reveal">
        <h2>{t.projects.designPhilosophyTitle}</h2>
        <p>{designPhilosophy}</p>
      </section>
    )}

    {technicalImplementation && (
      <section class="reveal">
        <h2>{t.projects.technicalImplementationTitle}</h2>
        <p>{technicalImplementation}</p>
      </section>
    )}

    {(keyFeaturesDone.length > 0 || keyFeaturesInProgress.length > 0) && (
      <section class="reveal">
        <h2>{t.projects.keyFeaturesTitle}</h2>
        {keyFeaturesDone.length > 0 && (
          <div class="feature-group">
            <p class="feature-group-label">{t.member.statusCompleted}</p>
            <ul class="feature-list feature-list-done">
              {keyFeaturesDone.map((f) => <li>{f}</li>)}
            </ul>
          </div>
        )}
        {keyFeaturesInProgress.length > 0 && (
          <div class="feature-group">
            <p class="feature-group-label">{t.common.inProgress}</p>
            <ul class="feature-list feature-list-in-progress">
              {keyFeaturesInProgress.map((f) => <li>{f}</li>)}
            </ul>
          </div>
        )}
      </section>
    )}

    {challengesAndDecisions && (
      <section class="reveal">
        <h2>{t.projects.challengesTitle}</h2>
        <p>{challengesAndDecisions}</p>
      </section>
    )}

    {currentProgress && (
      <section class="reveal current-progress">
        <h2>{t.projects.currentProgressTitle}</h2>
        <p>{currentProgress}</p>
      </section>
    )}

    {outcome && (
      <section class="reveal">
        <h2>{t.projects.outcomeTitle}</h2>
        <p>{outcome}</p>
      </section>
    )}

    {documents.length > 0 && (
      <section class="reveal">
        <h2>{t.projects.documentsTitle}</h2>
        {documentsNote && <p class="documents-note">{documentsNote}</p>}
        <ul class="documents-list">
          {documents.map((doc) => (
            <li>
              <a class="document-link" href={`${base}${doc.path}`} target="_blank" rel="noopener noreferrer" data-sound="click">
                {t.projects.downloadDocument}: {doc.label}
                <span class="muted document-size">({formatFileSize(doc.sizeBytes)})</span>
              </a>
              {doc.previewImages.length > 0 && (
                <div class="gallery-grid document-preview-grid">
                  {doc.previewImages.map((src, i) => (
                    <button
                      type="button"
                      class="gallery-item"
                      data-full={`${base}${src}`}
                      data-sound="click"
                      aria-label={`${t.projects.galleryInspect} ${i + 1}/${doc.previewImages.length}`}
                    >
                      <img src={`${base}${src}`} alt={`${doc.label} ${i + 1}`} loading="lazy" />
                    </button>
                  ))}
                </div>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    {gallery.length > 0 && (
      <section id="gallery" class="reveal">
        <h2>{t.projects.galleryTitle}</h2>
        <div class="gallery-grid">
          {gallery.map((src, i) => (
            <button
              type="button"
              class="gallery-item"
              data-full={`${base}${src}`}
              data-sound="click"
              aria-label={`${t.projects.galleryInspect} ${i + 1}/${gallery.length}`}
            >
              <img src={`${base}${src}`} alt={title} loading="lazy" />
            </button>
          ))}
        </div>
      </section>
    )}

    {hasLightbox && (
      <dialog class="lightbox" id="gallery-lightbox">
        <button type="button" class="lightbox-close" data-sound="click" aria-label={t.common.close}>&times;</button>
        <img class="lightbox-image" alt={title} />
      </dialog>
    )}

    {otherProjects.length > 0 && (
      <nav class="other-projects" aria-label={t.projects.otherProjectsTitle}>
        <h2>{t.projects.otherProjectsTitle}</h2>
        <ul>
          {otherProjects.map((p) => (
            <li><a href={localePath(lang, `projects/${p.slug}/`)}>{pick(p.title, lang)}</a></li>
          ))}
        </ul>
      </nav>
    )}
  </article>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#gallery-lightbox');
  const lightboxImage = dialog?.querySelector<HTMLImageElement>('.lightbox-image');
  if (dialog && lightboxImage) {
    document.querySelectorAll<HTMLButtonElement>('.gallery-item').forEach((btn) => {
      btn.addEventListener('click', () => {
        const full = btn.dataset.full;
        if (!full) return;
        lightboxImage.src = full;
        dialog.showModal();
      });
    });
    dialog.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .project-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-accent-soft);
    padding-block: var(--space-5) var(--space-6);
    isolation: isolate;
  }
  .facets {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .facet {
    position: absolute;
    display: block;
  }
  .f1 {
    width: 40%;
    height: 160%;
    top: -30%;
    right: -10%;
    background: var(--color-light-blue);
    opacity: 0.18;
    clip-path: polygon(30% 0, 100% 0, 100% 100%, 0 100%);
  }
  .f2 {
    width: 18%;
    height: 100%;
    top: 0;
    right: 22%;
    background: var(--color-blue);
    opacity: 0.12;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 70ch;
  }
  .meta {
    display: flex;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
  }
  .status-tag {
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }
  .hero-content h1 {
    margin-bottom: var(--space-2);
  }
  .lead {
    font-size: var(--fs-400);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .section-nav {
    position: sticky;
    top: 65px;
    z-index: 20;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    transition: background-color var(--duration-base) var(--ease-standard), border-color var(--duration-base) var(--ease-standard);
  }
  .section-nav-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    row-gap: var(--space-1);
    column-gap: var(--space-4);
    padding-block: var(--space-2);
  }
  .section-nav-share {
    flex-shrink: 0;
    margin-inline-start: auto;
  }
  .back-link {
    font-weight: var(--fw-medium);
    text-decoration: none;
    font-size: var(--fs-200);
  }

  .project-page {
    padding-block: var(--space-6) var(--space-7);
    display: grid;
    gap: var(--space-6);
  }
  .project-page h2 {
    font-size: var(--fs-600);
    border-bottom: var(--rule-weight) solid var(--color-blue);
    padding-bottom: var(--space-1);
    display: inline-block;
    margin-bottom: var(--space-3);
  }
  .muted {
    color: var(--color-text-muted);
  }

  .contributors-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }
  .contributors-list a {
    font-weight: var(--fw-medium);
    text-decoration: none;
  }

  .tag-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .feature-group {
    margin-bottom: var(--space-3);
  }
  .feature-group:last-child {
    margin-bottom: 0;
  }
  .feature-group-label {
    font-weight: var(--fw-heading);
    font-size: var(--fs-200);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }
  .feature-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .feature-list li {
    position: relative;
    padding-left: 1.5em;
  }
  .feature-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 8px;
    height: 8px;
  }
  .feature-list-done li::before {
    background: var(--color-blue);
    border-radius: 50%;
  }
  .feature-list-in-progress li::before {
    background: var(--color-accent-soft);
    border: 2px solid var(--color-accent-strong);
    border-radius: 50%;
    width: 6px;
    height: 6px;
  }
  .feature-list-in-progress li {
    color: var(--color-text-muted);
  }

  .current-progress {
    background: var(--color-bg-muted);
    padding: var(--space-4);
    border-left: 3px solid var(--color-blue);
  }
  .current-progress h2 {
    margin-bottom: var(--space-2);
  }

  .documents-note {
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }
  .documents-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .document-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-weight: var(--fw-heading);
    text-decoration: none;
    border-bottom: 2px solid var(--color-blue);
    width: fit-content;
  }
  .document-size {
    font-weight: var(--fw-regular);
    font-size: var(--fs-200);
  }
  .document-preview-grid {
    margin-top: var(--space-2);
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    max-width: 640px;
  }

  .gallery-grid {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }
  .gallery-item {
    display: block;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    width: 100%;
  }
  .gallery-item img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }
  .gallery-item:hover img,
  .gallery-item:focus-visible img {
    opacity: 0.85;
  }

  .lightbox {
    border: none;
    padding: 0;
    max-width: min(90vw, 1100px);
    max-height: 90vh;
    background: transparent;
  }
  .lightbox::backdrop {
    background: rgba(10, 12, 16, 0.85);
  }
  .lightbox-image {
    display: block;
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
  }
  .lightbox-close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    width: 2.25rem;
    height: 2.25rem;
    line-height: 1;
    font-size: 1.5rem;
    border: none;
    border-radius: 50%;
    background: rgba(10, 12, 16, 0.6);
    color: var(--color-white);
    cursor: pointer;
  }

  .project-video {
    width: 100%;
    max-width: 720px;
    aspect-ratio: 16 / 9;
    background: var(--color-charcoal);
  }

  .other-projects {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .other-projects h2 {
    font-size: var(--fs-500);
  }
  .other-projects ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }
  .other-projects a {
    font-weight: var(--fw-medium);
    text-decoration: none;
  }
</style>
