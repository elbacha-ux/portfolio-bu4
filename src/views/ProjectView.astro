---
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';
import Placeholder from '../components/Placeholder.astro';
import { people } from '../data/people';
import { projects } from '../data/projects';
import { ui } from '../i18n/ui';
import { pick, pickAll, localePath } from '../i18n';
import { projectGallery, hasProjectVideo, projectDocuments, documentPreviewImages } from '../lib/projectMedia';
import { formatFileSize } from '../lib/cv';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const t = ui[lang];
const project = projects.find((p) => p.slug === slug)!;

const title = pick(project.title, lang) ?? project.slug;
const description = pick(project.description, lang);
const category = pick(project.category, lang);
const outcome = pick(project.outcome, lang);
const tools = pickAll(project.tools, lang);
const skills = pickAll(project.skills, lang);
const documentsNote = pick(project.documentsNote, lang);
const members = project.memberSlugs.map((s) => people[s]).filter(Boolean);

const gallery = projectGallery(slug);
const hasVideo = hasProjectVideo(slug);
const base = import.meta.env.BASE_URL;
const videoSrc = hasVideo ? `${base}videos/${slug}.mp4` : null;

const documents = projectDocuments(slug).map((doc) => ({
  ...doc,
  previewImages: documentPreviewImages(slug, doc.label),
}));
const hasLightbox = gallery.length > 0 || documents.some((d) => d.previewImages.length > 0);

const otherProjects = projects.filter((p) => p.slug !== slug);
---

<BaseLayout lang={lang} title={title} description={description ?? title}>
  <header class="project-hero">
    <div class="facets" aria-hidden="true">
      <span class="facet f1"></span>
      <span class="facet f2"></span>
    </div>
    <div class="container hero-content reveal">
      <div class="meta">
        {category && <Tag>{category}</Tag>}
        {project.status === 'in-progress' && <Tag class="status-tag">{t.common.inProgress}</Tag>}
      </div>
      <h1>{title}</h1>
      {description && <p class="lead">{description}</p>}
      {project.link && (
        <a class="btn btn-primary" href={project.link} target="_blank" rel="noopener noreferrer" data-sound="click">
          {t.projects.visitSite}
          <span aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </header>

  <nav class="section-nav" aria-label={t.projects.title}>
    <div class="container section-nav-inner">
      <a class="back-link" href={localePath(lang, 'projects/')}>{t.common.backToProjects}</a>
    </div>
  </nav>

  <article class="container project-page">
    {members.length > 0 && (
      <section class="reveal">
        <h2>{t.projects.contributorsTitle}</h2>
        <ul class="contributors-list">
          {members.map((m) => (
            <li><a href={localePath(lang, `members/${m.slug}/`)}>{m.name}</a></li>
          ))}
        </ul>
      </section>
    )}

    {tools.length > 0 && (
      <section class="reveal">
        <h2>{t.projects.toolsTitle}</h2>
        <div class="tag-group">
          {tools.map((tool) => <Tag>{tool}</Tag>)}
        </div>
      </section>
    )}

    {skills.length > 0 && (
      <section class="reveal">
        <h2>{t.projects.skillsTitle}</h2>
        <div class="tag-group">
          {skills.map((skill) => <Tag>{skill}</Tag>)}
        </div>
      </section>
    )}

    {outcome && (
      <section class="reveal">
        <h2>{t.projects.outcomeTitle}</h2>
        <p>{outcome}</p>
      </section>
    )}

    {documents.length > 0 && (
      <section class="reveal">
        <h2>{t.projects.documentsTitle}</h2>
        {documentsNote && <p class="documents-note">{documentsNote}</p>}
        <ul class="documents-list">
          {documents.map((doc) => (
            <li>
              <a class="document-link" href={`${base}${doc.path}`} target="_blank" rel="noopener noreferrer" data-sound="click">
                {t.projects.downloadDocument}: {doc.label}
                <span class="muted document-size">({formatFileSize(doc.sizeBytes)})</span>
              </a>
              {doc.previewImages.length > 0 && (
                <div class="gallery-grid document-preview-grid">
                  {doc.previewImages.map((src, i) => (
                    <button
                      type="button"
                      class="gallery-item"
                      data-full={`${base}${src}`}
                      data-sound="click"
                      aria-label={`${t.projects.galleryInspect} ${i + 1}/${doc.previewImages.length}`}
                    >
                      <img src={`${base}${src}`} alt={`${doc.label} ${i + 1}`} loading="lazy" />
                    </button>
                  ))}
                </div>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    <section id="gallery" class="reveal">
      <h2>{t.projects.galleryTitle}</h2>
      {gallery.length > 0 ? (
        <div class="gallery-grid">
          {gallery.map((src, i) => (
            <button
              type="button"
              class="gallery-item"
              data-full={`${base}${src}`}
              data-sound="click"
              aria-label={`${t.projects.galleryInspect} ${i + 1}/${gallery.length}`}
            >
              <img src={`${base}${src}`} alt={title} loading="lazy" />
            </button>
          ))}
        </div>
      ) : (
        <div class="media-placeholder">
          <p class="muted">{t.projects.galleryComingSoonBody}</p>
          <Placeholder lang={lang} />
        </div>
      )}
    </section>

    {hasLightbox && (
      <dialog class="lightbox" id="gallery-lightbox">
        <button type="button" class="lightbox-close" data-sound="click" aria-label={t.common.close}>&times;</button>
        <img class="lightbox-image" alt={title} />
      </dialog>
    )}

    <section id="video" class="reveal">
      <h2>{t.projects.videoTitle}</h2>
      {videoSrc ? (
        <video controls preload="none" class="project-video">
          <source src={videoSrc} type="video/mp4" />
        </video>
      ) : project.videoUrl ? (
        <a class="btn btn-secondary" href={project.videoUrl} target="_blank" rel="noopener noreferrer" data-sound="click">
          {t.projects.videoTitle}
          <span aria-hidden="true">↗</span>
        </a>
      ) : (
        <div class="media-placeholder">
          <p class="muted">{t.projects.videoComingSoonBody}</p>
          <Placeholder lang={lang} />
        </div>
      )}
    </section>

    {otherProjects.length > 0 && (
      <nav class="other-projects" aria-label={t.projects.otherProjectsTitle}>
        <h2>{t.projects.otherProjectsTitle}</h2>
        <ul>
          {otherProjects.map((p) => (
            <li><a href={localePath(lang, `projects/${p.slug}/`)}>{pick(p.title, lang)}</a></li>
          ))}
        </ul>
      </nav>
    )}
  </article>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#gallery-lightbox');
  const lightboxImage = dialog?.querySelector<HTMLImageElement>('.lightbox-image');
  if (dialog && lightboxImage) {
    document.querySelectorAll<HTMLButtonElement>('.gallery-item').forEach((btn) => {
      btn.addEventListener('click', () => {
        const full = btn.dataset.full;
        if (!full) return;
        lightboxImage.src = full;
        dialog.showModal();
      });
    });
    dialog.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .project-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-accent-soft);
    padding-block: var(--space-5) var(--space-6);
    isolation: isolate;
  }
  .facets {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .facet {
    position: absolute;
    display: block;
  }
  .f1 {
    width: 40%;
    height: 160%;
    top: -30%;
    right: -10%;
    background: var(--color-light-blue);
    opacity: 0.18;
    clip-path: polygon(30% 0, 100% 0, 100% 100%, 0 100%);
  }
  .f2 {
    width: 18%;
    height: 100%;
    top: 0;
    right: 22%;
    background: var(--color-blue);
    opacity: 0.12;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 70ch;
  }
  .meta {
    display: flex;
    gap: var(--space-1);
    margin-bottom: var(--space-2);
  }
  .status-tag {
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }
  .hero-content h1 {
    margin-bottom: var(--space-2);
  }
  .lead {
    font-size: var(--fs-400);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .section-nav {
    position: sticky;
    top: 65px;
    z-index: 20;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    transition: background-color var(--duration-base) var(--ease-standard), border-color var(--duration-base) var(--ease-standard);
  }
  .section-nav-inner {
    padding-block: var(--space-2);
  }
  .back-link {
    font-weight: var(--fw-medium);
    text-decoration: none;
    font-size: var(--fs-200);
  }

  .project-page {
    padding-block: var(--space-6) var(--space-7);
    display: grid;
    gap: var(--space-6);
  }
  .project-page h2 {
    font-size: var(--fs-600);
    border-bottom: var(--rule-weight) solid var(--color-blue);
    padding-bottom: var(--space-1);
    display: inline-block;
    margin-bottom: var(--space-3);
  }
  .muted {
    color: var(--color-text-muted);
  }

  .contributors-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }
  .contributors-list a {
    font-weight: var(--fw-medium);
    text-decoration: none;
  }

  .tag-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .documents-note {
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }
  .documents-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .document-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-weight: var(--fw-heading);
    text-decoration: none;
    border-bottom: 2px solid var(--color-blue);
    width: fit-content;
  }
  .document-size {
    font-weight: var(--fw-regular);
    font-size: var(--fs-200);
  }
  .document-preview-grid {
    margin-top: var(--space-2);
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    max-width: 640px;
  }

  .gallery-grid {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }
  .gallery-item {
    display: block;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    width: 100%;
  }
  .gallery-item img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }
  .gallery-item:hover img,
  .gallery-item:focus-visible img {
    opacity: 0.85;
  }

  .lightbox {
    border: none;
    padding: 0;
    max-width: min(90vw, 1100px);
    max-height: 90vh;
    background: transparent;
  }
  .lightbox::backdrop {
    background: rgba(10, 12, 16, 0.85);
  }
  .lightbox-image {
    display: block;
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
  }
  .lightbox-close {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    width: 2.25rem;
    height: 2.25rem;
    line-height: 1;
    font-size: 1.5rem;
    border: none;
    border-radius: 50%;
    background: rgba(10, 12, 16, 0.6);
    color: var(--color-white);
    cursor: pointer;
  }

  .project-video {
    width: 100%;
    max-width: 720px;
    aspect-ratio: 16 / 9;
    background: var(--color-charcoal);
  }

  .media-placeholder {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-4);
    background: var(--color-bg-muted);
    max-width: 480px;
  }

  .other-projects {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .other-projects h2 {
    font-size: var(--fs-500);
  }
  .other-projects ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }
  .other-projects a {
    font-weight: var(--fw-medium);
    text-decoration: none;
  }
</style>
