---
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberHero from '../components/MemberHero.astro';
import MemberSkills from '../components/MemberSkills.astro';
import MemberProjects from '../components/MemberProjects.astro';
import CvSection from '../components/CvSection.astro';
import ShareButtons from '../components/ShareButtons.astro';
import Tag from '../components/Tag.astro';
import LinkList from '../components/LinkList.astro';
import Placeholder from '../components/Placeholder.astro';
import { people } from '../data/people';
import { team } from '../data/team';
import { ui } from '../i18n/ui';
import { pick, pickAll, localePath } from '../i18n';
import { hasCv } from '../lib/cv';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const t = ui[lang];
const member = people[slug];

const intro = pick(member.intro, lang);
const program = member.education ? pick(member.education.program, lang) : null;
const degrees = member.education ? pickAll(member.education.degrees, lang) : [];
const certifications = member.education
  ? member.education.certifications.map((c) => ({ label: pick(c.label, lang), file: c.file }))
  : [];
const base = import.meta.env.BASE_URL;
const interests = pickAll(member.interests, lang);

const links = [
  member.links.email ? { label: 'Email', href: `mailto:${member.links.email}` } : null,
  member.links.linkedin ? { label: 'LinkedIn', href: member.links.linkedin } : null,
  member.links.github ? { label: 'GitHub', href: member.links.github } : null,
].filter((l): l is { label: string; href: string } => l !== null);

const others = team.memberSlugs.filter((s) => s !== slug).map((s) => people[s]);
const memberHasCv = hasCv(slug);

const anchors = [
  { href: '#overview', label: t.member.navOverview, show: true },
  { href: '#skills', label: t.member.navSkills, show: member.skills.technical.length > 0 || member.skills.personal.length > 0 },
  { href: '#projects', label: t.member.navProjects, show: member.projects.length > 0 },
  { href: '#cv', label: t.member.navCv, show: memberHasCv },
].filter((a) => a.show);

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout lang={lang} title={member.name} description={intro ?? `${member.name} - BU4`} image={member.photo ?? undefined}>
  <MemberHero
    member={member}
    lang={lang}
    projectCount={member.projects.length}
    skillCount={member.skills.technical.length}
    languageCount={member.skills.languages.length}
    hasCv={memberHasCv}
  />

  <nav class="section-nav" aria-label={t.member.navOverview}>
    <div class="container section-nav-inner">
      <div class="section-nav-links">
        <a class="back-link" href={localePath(lang, 'team/')}>{t.common.backToTeam}</a>
        <ul class="anchors">
          {anchors.map((a) => <li><a href={a.href}>{a.label}</a></li>)}
        </ul>
      </div>
      <div class="section-nav-share">
        <ShareButtons url={pageUrl} title={member.name} lang={lang} />
      </div>
    </div>
  </nav>

  <article class="container member-page">
    <section id="overview" class="reveal">
      <h2>{t.member.educationTitle}</h2>
      {member.education ? (
        <div class="education">
          {program && <p><strong>{program}</strong>{member.education.institution && `, ${member.education.institution}`}</p>}
          {member.education.years && <p class="muted">{member.education.years}</p>}
          {degrees.length > 0 && <ul>{degrees.map((d) => <li>{d}</li>)}</ul>}
          {certifications.length > 0 && (
            <>
              <p class="label">{t.member.additionalTraining}</p>
              <ul>
                {certifications.map((c) => (
                  <li>
                    {c.file ? (
                      <a href={`${base}${c.file}`} target="_blank" rel="noopener noreferrer" data-sound="click">{c.label}</a>
                    ) : (
                      c.label
                    )}
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>
      ) : (
        <Placeholder label={t.member.placeholderEducation} lang={lang} variant="block" />
      )}

      {interests.length > 0 && (
        <>
          <p class="label">{t.member.interestsTitle}</p>
          <div class="tag-group">
            {interests.map((i) => <Tag>{i}</Tag>)}
          </div>
        </>
      )}

      <div class="links-row">
        <LinkList links={links} />
      </div>
    </section>

    <MemberSkills member={member} lang={lang} />
    <MemberProjects member={member} lang={lang} />

    {member.experience.length > 0 && (
      <section class="reveal">
        <h2>{t.member.experienceTitle}</h2>
        <ul>
          {member.experience.map((e) => {
            const detail = pick(e.detail, lang);
            return <li><strong>{e.organization}</strong>{detail && ` — ${detail}`}</li>;
          })}
        </ul>
      </section>
    )}

    {(member.goals.shortTerm || member.goals.longTerm) && (
      <section class="reveal">
        <h2>{t.member.goalsTitle}</h2>
        {member.goals.shortTerm && <p><strong>{t.member.shortTerm}:</strong> {pick(member.goals.shortTerm, lang)}</p>}
        {member.goals.longTerm && <p><strong>{t.member.longTerm}:</strong> {pick(member.goals.longTerm, lang)}</p>}
      </section>
    )}

    <CvSection slug={slug} name={member.name} lang={lang} />

    <nav class="other-members" aria-label={t.common.otherMembers}>
      <h2>{t.common.otherMembers}</h2>
      <ul>
        {others.map((m) => (
          <li><a href={localePath(lang, `members/${m.slug}/`)}>{m.name}</a></li>
        ))}
      </ul>
    </nav>
  </article>
</BaseLayout>

<style>
  .section-nav {
    position: sticky;
    top: 65px;
    z-index: 20;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    transition: background-color var(--duration-base) var(--ease-standard), border-color var(--duration-base) var(--ease-standard);
  }
  .section-nav-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    row-gap: var(--space-1);
    column-gap: var(--space-4);
    padding-block: var(--space-2);
  }
  .section-nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-width: 0;
    overflow-x: auto;
  }
  .section-nav-share {
    flex-shrink: 0;
    margin-inline-start: auto;
  }
  .back-link {
    flex-shrink: 0;
    font-weight: var(--fw-medium);
    text-decoration: none;
    font-size: var(--fs-200);
    white-space: nowrap;
  }
  .anchors {
    list-style: none;
    display: flex;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
  }
  .anchors a {
    font-size: var(--fs-200);
    font-weight: var(--fw-medium);
    text-decoration: none;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  .anchors a:hover {
    color: var(--color-accent-strong);
  }

  .member-page {
    padding-block: var(--space-6) var(--space-7);
    display: grid;
    gap: var(--space-6);
  }
  .member-page > section {
    scroll-margin-top: 90px;
  }
  .member-page h2 {
    font-size: var(--fs-600);
    border-bottom: var(--rule-weight) solid var(--color-blue);
    padding-bottom: var(--space-1);
    display: inline-block;
    margin-bottom: var(--space-3);
  }
  .label {
    font-weight: var(--fw-heading);
    margin-top: var(--space-3);
    margin-bottom: var(--space-1);
  }
  .muted {
    color: var(--color-text-muted);
  }
  .tag-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .links-row {
    margin-top: var(--space-3);
  }

  .other-members {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .other-members h2 {
    font-size: var(--fs-500);
  }
  .other-members ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }
  .other-members a {
    font-weight: var(--fw-medium);
    text-decoration: none;
  }
</style>
