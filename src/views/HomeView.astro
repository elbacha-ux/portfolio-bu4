---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import MemberGrid from '../components/MemberGrid.astro';
import ProjectList from '../components/ProjectList.astro';
import AwardCarousel from '../components/AwardCarousel.astro';
import BumSpotlight from '../components/BumSpotlight.astro';
import { site } from '../data/site';
import { ui } from '../i18n/ui';
import { localePath } from '../i18n';
import type { Lang } from '../i18n';
import { people } from '../data/people';
import { team } from '../data/team';
import { projects } from '../data/projects';
import { awards } from '../data/awards';
import { pickAll } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const members = team.memberSlugs.map((slug) => people[slug]);
const bum = people[team.bumSlug];
const featuredProjects = projects.slice(0, 3);
const description = site.description[lang];

const toSlug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const skillSlugs = new Set<string>();
for (const m of members) {
  for (const skill of pickAll(m.skills.technical.map((s) => s.name), lang)) skillSlugs.add(toSlug(skill));
}
const stats = [
  { value: members.length, label: t.home.statMembers },
  { value: projects.length, label: t.home.statProjects },
  { value: skillSlugs.size, label: t.home.statSkills },
];
---

<BaseLayout lang={lang} title={site.fullName} description={description} isHome>
  <section class="hero glow-bg" data-spotlight>
    <div class="facets" aria-hidden="true">
      <span class="facet f1" data-parallax="0.08"></span>
      <span class="facet f2" data-parallax="0.16"></span>
      <span class="facet f3" data-parallax="0.05"></span>
    </div>
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow">{t.home.heroEyebrow}</p>
        <h1>{t.home.heroTitle}</h1>
        <p class="lead">
          {description} {t.home.heroLeadSuffix}
        </p>
        <div class="hero-actions">
          <Button href={localePath(lang, 'projects/')}>{t.common.heroCta}</Button>
          <Button href={localePath(lang, 'contact/')} variant="secondary">{t.common.heroCtaSecondary}</Button>
        </div>
      </div>
      <div class="hero-mark reveal" aria-hidden="true">
        <span class="numeral">04</span>
      </div>
    </div>
    <div class="container stats-row reveal">
      <ul class="stats">
        {stats.map((s) => (
          <li>
            <span class="stat-value" data-count-to={s.value}>0</span>
            <span class="stat-label">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container section">
    <SectionHeading numeral="01" eyebrow={t.home.section1Eyebrow} title={t.home.section1Title} />
    <p class="intro-copy reveal">{t.home.section1Body}</p>
  </section>

  <section class="container section">
    <SectionHeading numeral="02" eyebrow={t.home.section2Eyebrow} title={t.home.section2Title} />
    <ProjectList projects={featuredProjects} lang={lang} />
    {projects.length > 3 && (
      <div class="section-cta"><Button href={localePath(lang, 'projects/')} variant="secondary">{t.common.seeAllProjects}</Button></div>
    )}
  </section>

  <section class="section-muted">
    <div class="container section">
      <SectionHeading numeral="03" eyebrow={t.home.section3Eyebrow} title={t.home.section3Title} />
      <MemberGrid members={members} lang={lang} />
      <div class="section-cta"><Button href={localePath(lang, 'team/')} variant="secondary">{t.common.seeFullTeam}</Button></div>
    </div>
  </section>

  <section class="container section">
    <SectionHeading numeral="" eyebrow={t.home.leadershipEyebrow} title={t.home.leadershipTitle} />
    <BumSpotlight bum={bum} lang={lang} variant="compact" />
  </section>

  <section class="container section">
    <SectionHeading numeral="05" eyebrow={t.home.awardsEyebrow} title={t.home.awardsTitle} />
    <p class="intro-copy reveal">{t.home.awardsLead}</p>
    <AwardCarousel awards={awards} lang={lang} />
    <div class="section-cta"><Button href={localePath(lang, 'awards/')} variant="secondary">{t.common.seeAllAwards}</Button></div>
  </section>

  <section class="closing">
    <div class="container closing-inner reveal">
      <h2>{t.home.closingTitle}</h2>
      <p>{t.home.closingBody}</p>
      <div class="hero-actions">
        <Button href={localePath(lang, 'projects/')} variant="inverse">{t.common.seeAllProjects}</Button>
        <Button href={localePath(lang, 'contact/')} variant="secondary" class="on-dark">{t.common.contactUs}</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const counters = document.querySelectorAll<HTMLElement>('[data-count-to]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function animateCount(el: HTMLElement) {
    const target = Number(el.dataset.countTo ?? '0');
    if (reduceMotion || !target) {
      el.textContent = String(target);
      return;
    }
    const duration = 1200;
    const start = performance.now();
    function tick(now: number) {
      const progress = Math.min(1, (now - start) / duration);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = String(Math.round(eased * target));
      if (progress < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  if (counters.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement);
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.6 }
    );
    counters.forEach((el) => io.observe(el));
  } else {
    counters.forEach((el) => animateCount(el));
  }
</script>

<style>
  .hero {
    position: relative;
    background: var(--color-accent-soft);
    overflow: hidden;
    isolation: isolate;
    transition: background-color var(--duration-base) var(--ease-standard);
  }
  .facets {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .facet {
    position: absolute;
    display: block;
  }
  .f1 {
    width: 42%;
    height: 170%;
    top: -35%;
    right: -12%;
    background: var(--color-light-blue);
    opacity: 0.16;
    clip-path: polygon(30% 0, 100% 0, 100% 100%, 0 100%);
  }
  .f2 {
    width: 20%;
    height: 120%;
    top: -10%;
    right: 20%;
    background: var(--color-blue);
    opacity: 0.1;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }
  .f3 {
    width: 16%;
    height: 60%;
    bottom: -10%;
    left: -4%;
    background: var(--color-blue);
    opacity: 0.08;
    clip-path: polygon(0 0, 100% 30%, 70% 100%, 0 100%);
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-5);
    align-items: center;
  }
  .hero-copy .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: var(--fw-heading);
    color: var(--color-accent-strong);
    margin-bottom: var(--space-2);
  }
  .hero-copy h1 {
    font-size: var(--fs-800);
    max-width: 18ch;
  }
  .lead {
    font-size: var(--fs-400);
    color: var(--color-text);
    max-width: 55ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .hero-mark {
    display: none;
  }

  .stats-row {
    position: relative;
    z-index: 1;
    padding-bottom: var(--space-5);
  }
  .stats {
    list-style: none;
    margin: 0;
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  .stats li {
    display: flex;
    flex-direction: column;
  }
  .stat-value {
    font-size: var(--fs-700);
    font-weight: var(--fw-black);
    color: var(--color-navy);
    line-height: 1;
  }
  .stat-label {
    margin-top: 0.3em;
    font-size: var(--fs-100);
    font-weight: var(--fw-heading);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .section {
    padding-block: var(--space-6);
  }
  .section-muted {
    background: var(--color-bg-muted);
    transition: background-color var(--duration-base) var(--ease-standard);
  }
  .intro-copy {
    max-width: 68ch;
    font-size: var(--fs-400);
    color: var(--color-text);
  }
  .section-cta {
    margin-top: var(--space-4);
  }

  .closing {
    background: var(--color-navy);
    color: var(--color-white);
    text-align: center;
  }
  .closing-inner {
    padding-block: var(--space-6);
  }
  .closing h2 {
    color: var(--color-white);
  }
  .closing .hero-actions {
    justify-content: center;
  }
  .closing :global(.on-dark.btn-secondary) {
    color: var(--color-white);
    border-color: var(--color-white);
  }
  .closing :global(.on-dark.btn-secondary:hover) {
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-white);
  }


  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 3fr 1fr;
    }
    .hero-mark {
      display: flex;
      justify-content: flex-end;
    }
    .hero-mark .numeral {
      font-size: 10rem;
      color: var(--color-light-blue);
      opacity: 0.6;
    }
  }
</style>
