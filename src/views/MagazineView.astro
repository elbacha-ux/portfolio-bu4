---
/**
 * BU4/JEENISo magazine page. The flipbook is driven entirely by
 * src/data/magazine-pages.json (generated by `npm run pages` from
 * public/magazine/magazine.pdf, see scripts/pdf-to-pages.mjs): more than
 * one page means the real interactive flipbook renders, otherwise the page
 * falls back to a plain cover teaser - the same "coming soon" convention
 * as CvSection.astro, just driven by page count instead of a null field.
 * The PDF download and podcast player are each driven by
 * src/data/magazine.ts and simply don't render until their value stops
 * being null.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MagazineFlipbook from '../components/MagazineFlipbook.astro';
import { magazine } from '../data/magazine';
import magazinePages from '../data/magazine-pages.json';
import { ui } from '../i18n/ui';
import { localePath, pick } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL;

const coverAlt = `${t.magazine.coverAltPrefix} "${magazine.title}"`;
const hasPodcast = magazine.podcast.audioPath !== null;
const hasFlipbook = magazinePages.pages.length > 1;
---

<BaseLayout lang={lang} title={t.magazine.title} description={t.magazine.lead} image={`${base}${magazine.cover}`}>
  <section class="container section">
    <SectionHeading numeral="06" eyebrow={t.magazine.eyebrow} title={t.magazine.title} />
    <p class="lead reveal">{t.magazine.lead}</p>

    <div class="magazine-layout">
      <div class="magazine-info reveal">
        <p class="magazine-issue-title">{magazine.title}</p>
        <p class="magazine-issue-subtitle">{magazine.subtitle}</p>

        <div class="magazine-description">
          {magazine.description.map((paragraph) => <p>{pick(paragraph, lang)}</p>)}
        </div>

        {magazine.pdfPath && (
          <a class="btn btn-primary magazine-pdf" href={`${base}${magazine.pdfPath}`} download data-sound="confirm">
            {t.magazine.pdfDownload}
          </a>
        )}

        {hasPodcast && (
          <div class="magazine-podcast">
            <h2>{t.magazine.podcastTitle}</h2>
            {magazine.podcast.episodeTitle && <p class="magazine-podcast-episode">{magazine.podcast.episodeTitle}</p>}
            {magazine.podcast.guest && (
              <p class="magazine-podcast-guest">{t.magazine.podcastGuestLabel}: {magazine.podcast.guest}</p>
            )}
            <audio class="magazine-player" controls src={`${base}${magazine.podcast.audioPath}`}>
            </audio>
          </div>
        )}

        <p class="magazine-team-line">
          {t.magazine.teamLinePrefix} <a href={localePath(lang, 'team/')}>{t.magazine.teamLinkText}</a>.
        </p>
      </div>

      {/* Fills the space beside the intro text with the same cover the
          flipbook uses as page 1 - sticky on desktop, clickable straight to
          the reader (plain, non-interactive when there's no reader to jump
          to). Moves below the text at full width on mobile via normal
          document flow (see .magazine-layout's single-column default). */}
      {hasFlipbook ? (
        <a href="#magazine-reader" class="magazine-cover-frame reveal" aria-label={t.magazine.flipbookLabel} data-sound="click">
          <img
            class="magazine-cover"
            src={`${base}${magazine.cover}`}
            width={magazine.coverWidth}
            height={magazine.coverHeight}
            alt={coverAlt}
            loading="eager"
          />
        </a>
      ) : (
        <div class="magazine-cover-frame reveal">
          <img
            class="magazine-cover"
            src={`${base}${magazine.cover}`}
            width={magazine.coverWidth}
            height={magazine.coverHeight}
            alt={coverAlt}
            loading="eager"
          />
        </div>
      )}
    </div>
  </section>

  {hasFlipbook && (
    <section id="magazine-reader" class="flipbook-stage-section">
      <div class="container">
        <MagazineFlipbook
          lang={lang}
          pages={magazinePages.pages}
          width={magazinePages.width}
          height={magazinePages.height}
          pdfPath={magazine.pdfPath ?? 'magazine/magazine.pdf'}
          coverAlt={coverAlt}
        />
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .lead {
    max-width: 65ch;
    margin-bottom: var(--space-5);
    color: var(--color-text-muted);
  }

  /* Single column (cover below the text, full width) by default; becomes
     a two-column grid with a sticky cover only once there's room for it
     beside the text, not just beside a narrow phone column. */
  .magazine-layout {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 900px) {
    .magazine-layout {
      grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
      align-items: start;
    }
  }

  .magazine-info {
    max-width: 70ch;
  }
  .magazine-issue-title {
    font-family: var(--font-primary);
    font-weight: var(--fw-heading);
    font-size: var(--fs-700);
    line-height: var(--lh-tight);
    margin: 0 0 var(--space-2);
  }
  /* Body text: at least 18px/1.125rem on desktop (var(--fs-400), the
     site's own "body large" token), 1.0625rem on mobile, ~1.6 line-height
     and a ~60ch measure - applies to both the subtitle and the
     description paragraphs, which read as one continuous intro. Full
     --color-text (not the muted token) for stronger contrast, same as
     the rest of the site's body copy. */
  .magazine-issue-subtitle,
  .magazine-description p {
    color: var(--color-text);
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 60ch;
  }
  @media (min-width: 768px) {
    .magazine-issue-subtitle,
    .magazine-description p {
      font-size: var(--fs-400);
    }
  }
  .magazine-issue-subtitle {
    margin: 0 0 var(--space-3);
  }

  .magazine-description {
    margin-bottom: var(--space-4);
  }
  .magazine-description p {
    margin-bottom: var(--space-3);
  }
  .magazine-description p:last-child {
    margin-bottom: 0;
  }

  .magazine-pdf {
    display: inline-flex;
    margin-bottom: var(--space-4);
  }

  .magazine-podcast {
    margin-bottom: var(--space-4);
    padding: var(--space-4);
    background: var(--color-accent-soft);
  }
  .magazine-podcast h2 {
    font-size: var(--fs-500);
    margin-bottom: var(--space-1);
  }
  .magazine-podcast-episode {
    font-weight: var(--fw-medium);
    margin-bottom: 0.25rem;
  }
  .magazine-podcast-guest {
    color: var(--color-text-muted);
    font-size: var(--fs-200);
    margin-bottom: var(--space-3);
  }
  .magazine-player {
    width: 100%;
  }

  .magazine-team-line {
    color: var(--color-text-muted);
  }

  .flipbook-stage-section {
    padding-block: var(--space-6);
  }

  /* Fills the space beside the intro text - full width under it on
     mobile (plain document flow, no grid column yet below 900px), a
     sticky column beside it from 900px up. Capped width so it doesn't
     stretch the whole column on a merely-wide phone/tablet view where
     the grid still hasn't kicked in. */
  .magazine-cover-frame {
    display: block;
    max-width: 320px;
    margin-inline: auto;
    perspective: 1400px;
  }
  @media (min-width: 900px) {
    .magazine-cover-frame {
      position: sticky;
      /* Clears the site header (position: sticky; top: 0) so the two
         don't overlap once both are pinned. */
      top: calc(var(--space-4) + 72px);
      max-width: none;
      margin-inline: 0;
    }
  }
  .magazine-cover {
    display: block;
    width: 100%;
    height: auto;
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }
  @media (prefers-reduced-motion: no-preference) {
    .magazine-cover {
      transition: transform var(--duration-base) var(--ease-standard), box-shadow var(--duration-base) var(--ease-standard);
    }
    .magazine-cover-frame:hover .magazine-cover,
    .magazine-cover-frame:focus-within .magazine-cover {
      transform: perspective(1400px) rotateY(-10deg) rotateX(2deg) scale(1.015);
      box-shadow: 0 35px 55px -25px rgba(0, 0, 0, 0.45);
    }
  }
</style>
