---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MemberGrid from '../components/MemberGrid.astro';
import Button from '../components/Button.astro';
import { people } from '../data/people';
import { team } from '../data/team';
import { ui } from '../i18n/ui';
import { localePath, pickAll } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const members = team.memberSlugs.map((slug) => people[slug]);
const bum = people[team.bumSlug];

const toSlug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const skillMap = new Map<string, string>();
for (const m of members) {
  for (const skill of pickAll(m.skills.technical.map((s) => s.name), lang)) {
    skillMap.set(toSlug(skill), skill);
  }
}
const allSkills = [...skillMap.entries()].sort((a, b) => a[1].localeCompare(b[1]));
const showFilters = allSkills.length > 1;
---

<BaseLayout lang={lang} title={t.team.title} description={t.team.lead}>
  <section class="container section">
    <SectionHeading numeral="03" eyebrow={t.team.eyebrow} title={t.team.title} />
    <p class="lead reveal">{t.team.lead}</p>

    {showFilters && (
      <div class="filters" role="group" aria-label={t.team.filterBySkill}>
        <button type="button" class="filter-chip is-active" data-filter="" data-sound="click">{t.member.filterAll}</button>
        {allSkills.map(([slug, label]) => (
          <button type="button" class="filter-chip" data-filter={slug} data-sound="click">{label}</button>
        ))}
      </div>
    )}

    <MemberGrid members={members} lang={lang} />
    <p class="empty-filter-state" hidden>{t.team.noMembersForSkill}</p>
  </section>

  <section class="container section bum-teaser reveal">
    <p>{t.team.ledByPrefix} <strong>{bum.name}</strong>, {t.team.bumTitle}.</p>
    <Button href={localePath(lang, 'bum/')} variant="secondary">{t.common.meetTheBum}</Button>
  </section>
</BaseLayout>

<script>
  const grid = document.querySelector<HTMLUListElement>('.member-grid');
  const chips = document.querySelectorAll<HTMLButtonElement>('.filters .filter-chip');
  const items = document.querySelectorAll<HTMLLIElement>('.member-grid > li');
  const emptyState = document.querySelector<HTMLElement>('.empty-filter-state');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter ?? '';
      chips.forEach((c) => c.classList.toggle('is-active', c === chip));
      grid?.classList.toggle('is-filtered', Boolean(filter));

      let visibleCount = 0;
      items.forEach((item) => {
        const skills = (item.dataset.skills ?? '').split(' ');
        const show = !filter || skills.includes(filter);
        item.hidden = !show;
        if (show) visibleCount += 1;
      });
      if (emptyState) emptyState.hidden = visibleCount > 0;
    });
  });
</script>

<style>
  .lead {
    max-width: 60ch;
    margin-bottom: var(--space-4);
    color: var(--color-text-muted);
  }
  .bum-teaser {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding-top: 0;
  }
  .bum-teaser p {
    margin: 0;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-4);
  }
  .filter-chip {
    font-size: var(--fs-100);
    font-weight: var(--fw-heading);
    padding: 0.4em 0.9em;
    border: 2px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard);
  }
  .filter-chip:hover {
    border-color: var(--color-accent);
  }
  .filter-chip.is-active {
    background: var(--color-navy);
    border-color: var(--color-navy);
    color: var(--color-white);
  }

  .empty-filter-state {
    color: var(--color-text-muted);
    font-style: italic;
    padding: var(--space-4) 0;
  }
</style>
